---
// src/components/Navbar.astro — Hope Community Church
// ─────────────────────────────────────────────────────────────────────────
// WHAT THIS FILE DOES
//   This is the dark blue menu bar at the top of every page — logo, menu
//   links, the "Mission" dropdown, and the hamburger menu used on phones.
//   Because it's one shared file, changing it here updates it everywhere.
//
// ONE LIST CONTROLS BOTH MENUS
//   The links below are defined ONCE, in the "navLinks" list right under
//   this comment (search "EDIT: menu links"). Both the desktop menu and
//   the phone hamburger menu are built automatically from this same list,
//   so you only ever need to update it in one place — you can't
//   accidentally make desktop and mobile show different links.
//
// HOW TO MAKE COMMON CHANGES
//   • Add a menu link      → copy a line inside "EDIT: menu links" below
//                             and change the label/href
//   • Remove a menu link    → delete its line inside "EDIT: menu links"
//   • Rename a menu link    → change the text inside the quotes after
//                             "label:"
//   • Add a link to the Mission dropdown → add a line inside the
//                             "dropdown: [ ... ]" part of the Mission entry
//   • Make a link the highlighted "button" style (like Contact Us) →
//                             add   cta: true   after its href
//
// This file has three parts, in this order:
//   1. The list below     — the menu links (edit this for content changes)
//   2. The HTML/markup    — turns the list into the desktop + mobile menus
//   3. The <style> block  — colours, spacing, the dropdown animation
//   4. The <script> block at the very bottom — makes the hamburger
//      button open/close the phone menu. You shouldn't need to touch
//      the markup, <style>, or <script> for normal updates.
// ─────────────────────────────────────────────────────────────────────────

// EDIT: menu links — this single list feeds BOTH the desktop and mobile menus
const navLinks = [
  { label: "Home", href: "/" },
  { label: "What's On", href: "/whats-on" },
  {
    label: "Mission",
    href: "/mission",
    // Sub-links shown in the "Mission" dropdown (desktop) and as indented
    // links under "Mission" in the phone menu (mobile).
    dropdown: [
      { label: "India", href: "/mission/india", flag: "🇮🇳" },
      { label: "Romania", href: "/mission/romania", flag: "🇷🇴" },
    ],
  },
  { label: "Room Hire", href: "/room-hire" },
  // cta: true gives this link the gold "button" highlight on desktop
  { label: "Contact Us", href: "/contact", cta: true },
];
---

<header class="navbar">
  <div class="navbar-inner">
    <a href="/" class="navbar-logo">
      <img src="/images/logo-white.svg" alt="Hope Community Church" class="h-16 w-auto" />
    </a>

    <!-- Desktop nav — built automatically from the "navLinks" list above -->
    <nav class="navbar-links" aria-label="Main navigation">
      {navLinks.map((link) => (
        link.dropdown ? (
          <!-- ── Link with hover dropdown (e.g. Mission) ── -->
          <div class="nav-dropdown-wrapper">
            <a href={link.href} class="nav-dropdown-trigger">
              {link.label}
              <!-- small chevron so users know there's a sub-menu -->
              <svg class="chevron" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
                <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
            <div class="nav-dropdown" role="menu">
              {link.dropdown.map((sub) => (
                <a href={sub.href} role="menuitem">
                  <span class="dropdown-flag">{sub.flag}</span>{sub.label}
                </a>
              ))}
            </div>
          </div>
          <!-- ── end dropdown link ── -->
        ) : (
          <a href={link.href} class={link.cta ? "navbar-cta" : undefined}>{link.label}</a>
        )
      ))}
    </nav>

    <!-- Mobile hamburger -->
    <button class="navbar-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <!-- Mobile dropdown — also built automatically from the "navLinks" list above -->
  <nav id="mobile-menu" class="mobile-menu" aria-label="Mobile navigation" hidden>
    {navLinks.map((link) => (
      <Fragment>
        <a href={link.href}>{link.label}</a>
        {link.dropdown && link.dropdown.map((sub) => (
          <!-- Mission sub-links indented slightly so the hierarchy is clear -->
          <a href={sub.href} class="mobile-sub-link">↳ {sub.label}</a>
        ))}
      </Fragment>
    ))}
  </nav>
</header>

<style>
  /* ─── Base navbar ─────────────────────────────────── */
  .navbar {
    background: #0d1f3c;
    border-bottom: 2px solid #c9a84c;
    position: sticky;
    top: 0;
    z-index: 100;
    font-family: 'Nunito', 'Century Gothic', sans-serif;
  }

  .navbar-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 28px;
    height: 68px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .navbar-logo {
    display: flex;
    flex-direction: column;
    gap: 1px;
    text-decoration: none;
  }

  /* ─── Desktop links ───────────────────────────────── */
  .navbar-links {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .navbar-links > a,
  .nav-dropdown-trigger {
    font-weight: 700;
    font-size: 12.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.78);
    text-decoration: none;
    padding: 8px 13px;
    border-radius: 4px;
    transition: color 0.15s, background 0.15s;
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .navbar-links > a:hover,
  .navbar-links > a[aria-current="page"],
  .nav-dropdown-wrapper:hover .nav-dropdown-trigger,
  .nav-dropdown-wrapper:focus-within .nav-dropdown-trigger {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.08);
  }

  .navbar-links a.navbar-cta {
    background: #c9a84c;
    color: #0d1f3c;
    font-weight: 800;
    padding: 8px 16px;
    margin-left: 6px;
  }

  .navbar-links a.navbar-cta:hover {
    background: #b8943d;
    color: #ffffff;
  }

  /* ─── Dropdown wrapper ────────────────────────────── */
  .nav-dropdown-wrapper {
    position: relative;
  }

  /* The chevron rotates when the dropdown is open */
  .chevron {
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  .nav-dropdown-wrapper:hover .chevron,
  .nav-dropdown-wrapper:focus-within .chevron {
    transform: rotate(180deg);
  }

  /* The dropdown panel — hidden by default */
  .nav-dropdown {
    position: absolute;
    top: calc(100% + 6px);  /* small gap below the trigger */
    left: 0;
    min-width: 170px;
    background: #0d1f3c;
    border: 1px solid rgba(201, 168, 76, 0.35);
    border-top: 2px solid #c9a84c;
    border-radius: 0 0 6px 6px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
    padding: 6px 0;

    /* Hidden state */
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s;
  }

  /* Show on hover OR keyboard focus-within */
  .nav-dropdown-wrapper:hover .nav-dropdown,
  .nav-dropdown-wrapper:focus-within .nav-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .nav-dropdown a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 11px 18px;
    font-weight: 700;
    font-size: 12.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.82);
    text-decoration: none;
    transition: color 0.15s, background 0.15s;
  }

  .nav-dropdown a:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.07);
  }

  .dropdown-flag {
    font-size: 16px;
    line-height: 1;
  }

  /* ─── Hamburger button ────────────────────────────── */
  .navbar-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }

  .navbar-toggle span {
    display: block;
    width: 24px;
    height: 2px;
    background: #ffffff;
    border-radius: 2px;
    transition: transform 0.2s, opacity 0.2s;
  }

  .navbar-toggle[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .navbar-toggle[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }
  .navbar-toggle[aria-expanded="true"] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* ─── Mobile dropdown ─────────────────────────────── */
  .mobile-menu {
    background: #162d52;
    display: flex;
    flex-direction: column;
    padding: 12px 0 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .mobile-menu[hidden] {
    display: none;
  }

  .mobile-menu a {
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.82);
    text-decoration: none;
    padding: 13px 28px;
    transition: color 0.15s, background 0.15s;
  }

  .mobile-menu a:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.06);
  }

  /* Mission sub-links (India / Romania) are indented */
  .mobile-menu .mobile-sub-link {
    padding-left: 44px;
    font-size: 12.5px;
    color: rgba(255, 255, 255, 0.6);
  }

  .mobile-menu .mobile-sub-link:hover {
    color: #c9a84c;
  }

  /* ─── Responsive breakpoint ───────────────────────── */
  @media (max-width: 860px) {
    .navbar-links {
      display: none;
    }
    .navbar-toggle {
      display: flex;
    }
  }
</style>

<script>
  // ── Mobile hamburger toggle ──────────────────────────
  const toggle = document.querySelector('.navbar-toggle') as HTMLButtonElement;
  const menu   = document.getElementById('mobile-menu') as HTMLElement;

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!isOpen));
    menu.hidden = isOpen;
  });
</script>

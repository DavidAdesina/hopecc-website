---
// src/components/Navbar.astro — Hope Community Church
// ─────────────────────────────────────────────────────────────────────────
// WHAT THIS FILE DOES
//   This is the dark blue menu bar at the top of every page — logo, menu
//   links, the "Mission" dropdown, and the hamburger menu used on phones.
//   Because it's one shared file, changing it here updates it everywhere.
//
// IMPORTANT: THERE ARE TWO MENUS TO KEEP IN SYNC
//   This file lists the menu links TWICE — once for desktop (search
//   "EDIT: desktop menu links") and once for the phone hamburger menu
//   (search "EDIT: mobile menu links"). If you add, remove or rename a
//   page link, update BOTH lists so desktop and mobile match.
//
// HOW TO MAKE COMMON CHANGES
//   • Add/remove/rename a menu link → update both "EDIT: desktop menu
//     links" and "EDIT: mobile menu links" below
//   • Add a dropdown to a menu link  → wrap it in a
//     <div class="nav-dropdown-wrapper"> and add a
//     <div class="nav-dropdown"> with your <a> links inside — the
//     styling and hover/click behaviour is handled automatically
//
// This file has three parts, in this order:
//   1. The HTML below   — the menu structure and links
//   2. The <style> block — colours, spacing, the dropdown animation
//   3. The <script> block at the very bottom — makes the hamburger
//      button open/close the phone menu. You shouldn't need to touch
//      the <style> or <script> blocks for normal updates.
// ─────────────────────────────────────────────────────────────────────────
---

<header class="navbar">
  <div class="navbar-inner">
    <a href="/" class="navbar-logo">
      <img src="/images/logo-white.svg" alt="Hope Community Church" class="h-16 w-auto" />
    </a>

    <!-- Desktop nav -->
    <!-- EDIT: desktop menu links — remember to also update "EDIT: mobile menu links" below -->
    <nav class="navbar-links" aria-label="Main navigation">
      <a href="/">Home</a>
      <a href="/whats-on">What's On</a>

      <!-- ── Mission link with hover dropdown ── -->
      <div class="nav-dropdown-wrapper">
        <a href="/mission" class="nav-dropdown-trigger">
          Mission
          <!-- small chevron so users know there's a sub-menu -->
          <svg class="chevron" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
            <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <div class="nav-dropdown" role="menu">
          <a href="/mission/india" role="menuitem">
            <span class="dropdown-flag">🇮🇳</span>India
          </a>
          <a href="/mission/romania" role="menuitem">
            <span class="dropdown-flag">🇷🇴</span>Romania
          </a>
        </div>
      </div>
      <!-- ── end Mission dropdown ── -->

      <a href="/room-hire">Room Hire</a>
      <a href="/contact" class="navbar-cta">Contact Us</a>
    </nav>

    <!-- Mobile hamburger -->
    <button class="navbar-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <!-- Mobile dropdown -->
  <!-- EDIT: mobile menu links — keep this in sync with "EDIT: desktop menu links" above -->
  <nav id="mobile-menu" class="mobile-menu" aria-label="Mobile navigation" hidden>
    <a href="/">Home</a>
    <a href="/whats-on">What's On</a>
    <a href="/mission">Mission</a>
    <!-- Mobile sub-links indented slightly so the hierarchy is clear -->
    <a href="/mission/india" class="mobile-sub-link">↳ India</a>
    <a href="/mission/romania" class="mobile-sub-link">↳ Romania</a>
    <a href="/room-hire">Room Hire</a>
    <a href="/contact">Contact Us</a>
  </nav>
</header>

<style>
  /* ─── Base navbar ─────────────────────────────────── */
  .navbar {
    background: #0d1f3c;
    border-bottom: 2px solid #c9a84c;
    position: sticky;
    top: 0;
    z-index: 100;
    font-family: 'Nunito', 'Century Gothic', sans-serif;
  }

  .navbar-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 28px;
    height: 68px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .navbar-logo {
    display: flex;
    flex-direction: column;
    gap: 1px;
    text-decoration: none;
  }

  /* ─── Desktop links ───────────────────────────────── */
  .navbar-links {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .navbar-links > a,
  .nav-dropdown-trigger {
    font-weight: 700;
    font-size: 12.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.78);
    text-decoration: none;
    padding: 8px 13px;
    border-radius: 4px;
    transition: color 0.15s, background 0.15s;
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .navbar-links > a:hover,
  .navbar-links > a[aria-current="page"],
  .nav-dropdown-wrapper:hover .nav-dropdown-trigger,
  .nav-dropdown-wrapper:focus-within .nav-dropdown-trigger {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.08);
  }

  .navbar-links a.navbar-cta {
    background: #c9a84c;
    color: #0d1f3c;
    font-weight: 800;
    padding: 8px 16px;
    margin-left: 6px;
  }

  .navbar-links a.navbar-cta:hover {
    background: #b8943d;
    color: #ffffff;
  }

  /* ─── Dropdown wrapper ────────────────────────────── */
  .nav-dropdown-wrapper {
    position: relative;
  }

  /* The chevron rotates when the dropdown is open */
  .chevron {
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  .nav-dropdown-wrapper:hover .chevron,
  .nav-dropdown-wrapper:focus-within .chevron {
    transform: rotate(180deg);
  }

  /* The dropdown panel — hidden by default */
  .nav-dropdown {
    position: absolute;
    top: calc(100% + 6px);  /* small gap below the trigger */
    left: 0;
    min-width: 170px;
    background: #0d1f3c;
    border: 1px solid rgba(201, 168, 76, 0.35);
    border-top: 2px solid #c9a84c;
    border-radius: 0 0 6px 6px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
    padding: 6px 0;

    /* Hidden state */
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s;
  }

  /* Show on hover OR keyboard focus-within */
  .nav-dropdown-wrapper:hover .nav-dropdown,
  .nav-dropdown-wrapper:focus-within .nav-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .nav-dropdown a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 11px 18px;
    font-weight: 700;
    font-size: 12.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.82);
    text-decoration: none;
    transition: color 0.15s, background 0.15s;
  }

  .nav-dropdown a:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.07);
  }

  .dropdown-flag {
    font-size: 16px;
    line-height: 1;
  }

  /* ─── Hamburger button ────────────────────────────── */
  .navbar-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }

  .navbar-toggle span {
    display: block;
    width: 24px;
    height: 2px;
    background: #ffffff;
    border-radius: 2px;
    transition: transform 0.2s, opacity 0.2s;
  }

  .navbar-toggle[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .navbar-toggle[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }
  .navbar-toggle[aria-expanded="true"] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* ─── Mobile dropdown ─────────────────────────────── */
  .mobile-menu {
    background: #162d52;
    display: flex;
    flex-direction: column;
    padding: 12px 0 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .mobile-menu[hidden] {
    display: none;
  }

  .mobile-menu a {
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.82);
    text-decoration: none;
    padding: 13px 28px;
    transition: color 0.15s, background 0.15s;
  }

  .mobile-menu a:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.06);
  }

  /* Mission sub-links (India / Romania) are indented */
  .mobile-menu .mobile-sub-link {
    padding-left: 44px;
    font-size: 12.5px;
    color: rgba(255, 255, 255, 0.6);
  }

  .mobile-menu .mobile-sub-link:hover {
    color: #c9a84c;
  }

  /* ─── Responsive breakpoint ───────────────────────── */
  @media (max-width: 860px) {
    .navbar-links {
      display: none;
    }
    .navbar-toggle {
      display: flex;
    }
  }
</style>

<script>
  // ── Mobile hamburger toggle ──────────────────────────
  const toggle = document.querySelector('.navbar-toggle') as HTMLButtonElement;
  const menu   = document.getElementById('mobile-menu') as HTMLElement;

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!isOpen));
    menu.hidden = isOpen;
  });
</script>

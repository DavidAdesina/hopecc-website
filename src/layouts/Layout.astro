---
// src/layouts/Layout.astro — Hope Community Church
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Hope Community Church — a warm, welcoming church family in Hinckley, Leicestershire. Christ centred, People focused.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Share image for link previews (WhatsApp, iMessage, Facebook, X, …).
// Served from the CloudFront domain — NOT Astro.site — on purpose: until
// the DNS cutover, hopecc.org.uk still points at the old host, so link
// scrapers could never fetch an image from there. This URL keeps working
// after the cutover too; switching it to the real domain then is optional
// tidy-up (see README, "Favicons & share image").
const ogImage = 'https://d3jmbi4qqbxnbe.cloudfront.net/images/og-home.jpg';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary meta -->
    <title>{title} | Hope Community Church</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} | Hope Community Church`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The Hope Community Church building on Deveron Way, Hinckley — Christ centred, People focused" />
    <meta property="og:site_name" content="Hope Community Church" />
    <meta property="og:locale" content="en_GB" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | Hope Community Church`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Icons — all built from the church's flame logo (the same flame as
         HeroFlame.astro / logo-white.svg). To regenerate when Ian's new
         logo arrives, see README, "Favicons & share image". -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#0d1f3c" />

    <!-- Google Fonts: Nunito -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Cloudflare Web Analytics -->
    <script type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "9a982ea96405442588d77242d40c4466"}'></script>
    <!-- End Cloudflare Web Analytics -->
  </head>

  <body>
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  /* Reset & base */
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root {
    --navy: #0d1f3c;
    --navy-mid: #162d52;
    --blue: #4a90c4;
    --blue-light: #a8cce8;
    --blue-pale: #e8f2f9;
    --gold: #c9a84c;
    --gold-light: #f0dfa0;
    --cream: #f7f9fc;
    --white: #ffffff;
    --text-dark: #0d1f3c;
    --text-mid: #3a4a5c;
    --text-muted: #6b7c93;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: 'Nunito', 'Century Gothic', sans-serif;
    background: var(--cream);
    color: var(--text-dark);
    font-size: 16px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  img,
  video {
    max-width: 100%;
    display: block;
  }

  a {
    color: inherit;
  }

  /* Tailwind @tailwind directives — keep these if you have Tailwind installed */
  /* @tailwind base; */
  /* @tailwind components; */
  /* @tailwind utilities; */
</style>

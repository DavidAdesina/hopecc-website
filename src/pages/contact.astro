---
// contact.astro — Hope Community Church
// ─────────────────────────────────────────────────────────────────────────
// WHAT THIS FILE DOES
//   This produces the Contact page — contact details, a map, and a contact
//   form. It uses the shared <Layout> (Navbar + Footer) like every other
//   page, so it gets the same mobile hamburger menu and footer.
//
//   THE CANDLELIT WINDOWS: each way of contacting the church (phone,
//   email, directions, Facebook, YouTube, safeguarding) is drawn as a
//   small arched window — like a church window with coloured glass. At
//   rest they sit dim. On a computer, moving the mouse over one kindles
//   it: the glass lights up as if a candle were placed inside, a gleam
//   sweeps across it, tiny embers rise, and the row leans gently toward
//   the cursor — a warm glow also follows the mouse across the card,
//   like carrying a candle past the windows. On phones there's no mouse,
//   so instead the windows kindle one by one, top to bottom, as the card
//   scrolls into view, and glow when tapped. The church's own flame
//   (from HeroFlame.astro, the same living flame as the homepage) burns
//   beside the heading, over the verse "Call to me and I will answer
//   you" (Jeremiah 33:3). All of it is decoration only: every link works
//   exactly the same with it switched off, visitors who ask their device
//   for reduced motion get a still, softly-lit scene, and it uses no
//   added libraries — just the same HTML/CSS/JavaScript as everywhere
//   else on the site.
//
//   ROOM HIRE MODE: when this page is opened with ?enquiry=room-hire in
//   the web address (e.g. from clicking "Room Hire" in the menu), a gold
//   banner appears above the form, the Subject field is pre-filled, and a
//   checklist of details to include is shown. There's no separate
//   room-hire page — this one file handles both cases.
//
// HOW TO MAKE COMMON CHANGES
//   • Contact details (phone,
//     email, address, socials)   → search "EDIT: contact details"
//   • Room hire banner heading   → search "EDIT: Room hire banner"
//   • Room hire checklist items  → search "EDIT: Room hire checklist"
//   • Room hire pre-filled
//     subject line                → search "EDIT: Room hire pre-fill text"
//   • Form fields                → search "EDIT: form fields"
//   • Success/thank-you message  → search "EDIT: success message"
//   • The verse under "Contact
//     Details" (change or remove) → search "EDIT: verse line"
//   • Calm the windows' motion
//     down, or turn it all off    → search "EDIT: window motion"
//
//   Note: photo used behind the page heading — needs to exist at
//   public/images/church-building.jpeg
//
// This file has three parts, in this order:
//   1. The HTML below    — the words and layout people see on the page
//   2. The <style> block — colours, spacing and fonts
//   3. TWO <script> blocks at the very end — the first makes the
//      room-hire banner show/hide, pre-fills the form and handles form
//      submission; the second only moves the candlelit windows (the
//      page works identically without it). You shouldn't need to touch
//      the <style> or <script> blocks for normal text updates.
// ─────────────────────────────────────────────────────────────────────────
import Layout from '../layouts/Layout.astro';
import HeroFlame from '../components/HeroFlame.astro';
---

<Layout
  title="Contact"
  description="Get in touch with Hope Community Church in Hinckley — phone, email, room hire enquiries and directions."
>
  <div class="page-wrapper">
    <div class="bg-image"></div>
    <div class="bg-overlay"></div>

    <!-- Heading — JS updates this text if in room-hire mode -->
    <!-- EDIT: Room hire banner — update heading/subtext for room-hire mode in the JS below (search "roomHireMode") -->
    <header class="page-heading" id="pageHeading">
      <h1 id="pageTitle">Get in <span>Touch</span></h1>
      <p id="pageSubtitle">We'd love to hear from you — everyone is welcome</p>
      <div class="gold-rule"></div>
    </header>

    <!-- Main grid -->
    <main class="contact-grid">
      <!-- Left: Contact details — EDIT: contact details — phone, email, address, socials below.
           Each option sits in a little arched "candlelit window" — see the
           note at the very top of this file. Only the words in the
           detail-label / detail-value lines ever need editing; the windows,
           glow and motion look after themselves. -->
      <div class="glass details-card" id="detailsCard">
        <!-- The warm candlelight that follows the mouse across this card
             (decoration only — hidden from screen readers, ignores clicks) -->
        <div class="card-candlelight" aria-hidden="true"></div>

        <div class="details-header">
          <!-- The church's own living flame, same as the homepage hero -->
          <div class="details-flame" aria-hidden="true">
            <HeroFlame />
          </div>
          <h2>Contact Details</h2>
        </div>

        <!-- EDIT: verse line — the small scripture whisper under the heading.
             Change the words freely, or delete this one <p> line (and
             nothing else) to remove it entirely. -->
        <p class="verse-whisper">“Call to me and I will answer you” — Jeremiah 33:3</p>

        <a href="tel:01455233798" class="detail-item">
          <div class="detail-icon icon-phone" aria-hidden="true">
            <svg class="di-glyph" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            <i class="ember"></i><i class="ember"></i><i class="ember"></i>
          </div>
          <div class="detail-text">
            <div class="detail-label">Telephone</div>
            <div class="detail-value">01455 233798</div>
          </div>
          <div class="detail-arrow">›</div>
        </a>

        <a href="mailto:info@hopecc.org.uk" class="detail-item">
          <div class="detail-icon icon-email" aria-hidden="true">
            <svg class="di-glyph" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
            <i class="ember"></i><i class="ember"></i><i class="ember"></i>
          </div>
          <div class="detail-text">
            <div class="detail-label">Email Us</div>
            <div class="detail-value">info@hopecc.org.uk</div>
          </div>
          <div class="detail-arrow">›</div>
        </a>

        <a
          href="https://www.google.co.uk/maps/dir//Hope+Community+Church,+Deveron+Way,+Hinckley+LE10+0XD/@52.5440641,-1.3877352,17z/data=!4m9!4m8!1m0!1m5!1m1!1s0x4877500b54eaece5:0x3aa0e27e6b840aec!2m2!1d-1.3877306!2d52.5440545!3e0?entry=ttu&g_ep=EgoyMDI2MDUyMC4wIKXMDSoASAFQAw%3D%3D"
          class="detail-item"
          target="_blank"
          rel="noopener"
        >
          <div class="detail-icon icon-map" aria-hidden="true">
            <svg class="di-glyph" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            <i class="ember"></i><i class="ember"></i><i class="ember"></i>
          </div>
          <div class="detail-text">
            <div class="detail-label">Find Us</div>
            <div class="detail-value">Deveron Way, Hinckley LE10 0XD</div>
          </div>
          <div class="detail-arrow">›</div>
        </a>

        <a
          href="https://www.facebook.com/hopechurchhinc"
          class="detail-item"
          target="_blank"
          rel="noopener"
        >
          <div class="detail-icon icon-fb" aria-hidden="true">
            <svg class="di-glyph" width="22" height="22" viewBox="0 0 24 24" fill="white"
              ><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"
              ></path></svg
            >
            <i class="ember"></i><i class="ember"></i><i class="ember"></i>
          </div>
          <div class="detail-text">
            <div class="detail-label">Facebook</div>
            <div class="detail-value">Hope Church Hinckley</div>
          </div>
          <div class="detail-arrow">›</div>
        </a>

        <a
          href="https://www.youtube.com/@hopecommunitychurch328/featured"
          class="detail-item"
          target="_blank"
          rel="noopener"
        >
          <div class="detail-icon icon-yt" aria-hidden="true">
            <svg class="di-glyph" width="22" height="22" viewBox="0 0 24 24" fill="white"
              ><path
                d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46a2.78 2.78 0 0 0-1.95 1.96A29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58A2.78 2.78 0 0 0 3.41 19.6C5.12 20 12 20 12 20s6.88 0 8.59-.4a2.78 2.78 0 0 0 1.95-1.95A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"
              ></path><polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02" fill="#cc0000"
              ></polygon></svg
            >
            <i class="ember"></i><i class="ember"></i><i class="ember"></i>
          </div>
          <div class="detail-text">
            <div class="detail-label">YouTube</div>
            <div class="detail-value">Hope Community Church</div>
          </div>
          <div class="detail-arrow">›</div>
        </a>

        <a href="mailto:safeguarding@hopecc.org" class="detail-item">
          <div class="detail-icon icon-sg" aria-hidden="true">
            <svg class="di-glyph" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><path d="m9 12 2 2 4-4"></path></svg>
            <i class="ember"></i><i class="ember"></i><i class="ember"></i>
          </div>
          <div class="detail-text">
            <div class="detail-label">Safeguarding</div>
            <div class="detail-value">safeguarding@hopecc.org</div>
          </div>
          <div class="detail-arrow">›</div>
        </a>
      </div>

      <!-- Right: Contact form -->
      <div class="glass form-card" id="formCard">
        <!-- ═══════════════════════════════════════════════════
             ROOM HIRE BANNER
             Hidden by default. JS adds class "visible" when
             ?enquiry=room-hire is in the URL.
             EDIT: Room hire checklist — update the text inside each .checklist-item below
        ═══════════════════════════════════════════════════ -->
        <div
          class="room-hire-banner"
          id="roomHireBanner"
          role="note"
          aria-label="Room Hire Enquiry guidance"
        >
          <div class="banner-header">
            <div class="banner-header-icon">🏠</div>
            <div class="banner-header-text">
              <!-- EDIT: Room hire banner — update the heading and sub-line here -->
              <strong>Room Hire Enquiry</strong>
              <span>Use the form below to check availability and book a room</span>
            </div>
          </div>

          <div class="banner-body">
            <p>
              To help us confirm your booking as quickly as possible, please include the following
              details in your message:
            </p>

            <!-- EDIT: Room hire checklist — add, remove or change items here -->
            <div class="checklist">
              <div class="checklist-item">
                <div class="check-icon">✓</div>
                <span><strong>Date required</strong> — the day and date you need the room</span>
              </div>
              <div class="checklist-item">
                <div class="check-icon">✓</div>
                <span
                  ><strong>Start and finish time</strong> — including any set-up time you may need</span
                >
              </div>
              <div class="checklist-item">
                <div class="check-icon">✓</div>
                <span><strong>Purpose of hire</strong> — what the room will be used for</span>
              </div>
              <div class="checklist-item">
                <div class="check-icon">✓</div>
                <span><strong>Number of people</strong> — how many will be attending</span>
              </div>
              <div class="checklist-item">
                <div class="check-icon">✓</div>
                <span
                  ><strong>Your contact details</strong> — name, phone number and email address</span
                >
              </div>
            </div>

            <button
              class="banner-dismiss"
              id="bannerDismiss"
              aria-label="Dismiss room hire guidance"
            >
              ✕ &nbsp;Dismiss this guidance
            </button>
          </div>
        </div>
        <!-- end room hire banner -->

        <h2 id="formTitle">Send Us a Message</h2>

        <!-- EDIT: form fields — add, remove or relabel fields below. Any
             field with `required` must be filled in before the form can
             be submitted. -->
        <form id="contactForm" novalidate>
          <div class="form-grid-2">
            <div class="form-row">
              <label for="fname">First Name</label>
              <input type="text" id="fname" name="fname" placeholder="Jane" required />
            </div>
            <div class="form-row">
              <label for="lname">Last Name</label>
              <input type="text" id="lname" name="lname" placeholder="Smith" />
            </div>
          </div>

          <div class="form-row">
            <label for="email">Email Address</label>
            <input type="email" id="email" name="email" placeholder="jane@example.com" required />
          </div>

          <div class="form-row">
            <label for="phone">Phone (optional)</label>
            <input type="tel" id="phone" name="phone" placeholder="07700 900000" />
          </div>

          <div class="form-row">
            <label for="subject">Subject</label>
            <!-- EDIT: Room hire pre-fill text — update the value set in JS (search "Room Hire Enquiry" in the script) -->
            <input type="text" id="subject" name="subject" placeholder="How can we help?" />
          </div>

          <div class="form-row">
            <label for="message">Message</label>
            <textarea id="message" name="message" placeholder="Write your message here…" required
            ></textarea>
          </div>

          <!-- Honeypot: invisible to real visitors and left blank by them.
               Bots that auto-fill every field they find often fill this one
               in too, which the backend uses to silently discard the
               submission without sending an email. aria-hidden and
               tabindex="-1" keep it out of the way for screen readers and
               keyboard navigation. -->
          <div class="hp-field" aria-hidden="true">
            <label for="website">Website</label>
            <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
          </div>

          <button type="submit" class="submit-btn" id="submitBtn">Send Message</button>

          <div class="toast" id="toast"></div>
        </form>
      </div>

      <!-- Map -->
      <div class="glass map-card">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2434.5!2d-1.3877306!3d52.5440545!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x4877500b54eaece5%3A0x3aa0e27e6b840aec!2sHope%20Community%20Church%2C%20Deveron%20Way%2C%20Hinckley%20LE10%200XD!5e0!3m2!1sen!2suk!4v1234567890"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Hope Community Church location"
        >
        </iframe>
      </div>
    </main>
  </div>
</Layout>

<style>
  :root {
    --navy: #0d1f3c;
    --blue: #4a90c4;
    --pale: #e8f2f9;
    --gold: #c9a84c;
    --cream: #f7f9fc;
    --white: #ffffff;
  }

  /* ── Hero background ── */
  .page-wrapper {
    min-height: calc(100vh - 300px);
    position: relative;
  }

  .bg-image {
    position: fixed;
    inset: 0;
    background: url('/images/church-building.jpeg') center center / cover no-repeat;
    z-index: -2;
  }

  .bg-overlay {
    position: fixed;
    inset: 0;
    background: linear-gradient(
      160deg,
      rgba(13, 31, 60, 0.82) 0%,
      rgba(13, 31, 60, 0.7) 40%,
      rgba(74, 144, 196, 0.55) 100%
    );
    z-index: -1;
  }

  /* ── Page heading ── */
  .page-heading {
    position: relative;
    text-align: center;
    padding: 3.5rem 1rem 2rem;
  }

  .page-heading h1 {
    font-size: clamp(2.4rem, 5vw, 4rem);
    font-weight: 900;
    color: var(--white);
    letter-spacing: 0.02em;
    line-height: 1.1;
  }

  .page-heading h1 span {
    color: var(--gold);
  }

  .page-heading p {
    margin-top: 0.75rem;
    color: rgba(255, 255, 255, 0.75);
    font-size: 1.1rem;
    font-weight: 600;
  }

  .gold-rule {
    width: 64px;
    height: 4px;
    background: var(--gold);
    border-radius: 2px;
    margin: 1rem auto 0;
  }

  /* ── Main grid ── */
  .contact-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.75rem;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 2rem 4rem;
    width: 100%;
  }

  /* ── Glass card base ── */
  .glass {
    background: rgba(13, 31, 60, 0.72);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 20px;
    overflow: hidden;
  }

  /* ── Contact details card — "the candlelit windows" ──────────────────
     EDIT: window motion — everything from here down to the Form card
     section is only the look and motion of the six contact windows.
     To calm it all down, the numbers to nudge are marked below; to turn
     the motion OFF entirely, delete the SECOND <script> block at the
     very bottom of this file (the windows then simply sit softly lit —
     every link keeps working). */
  .details-card {
    position: relative;
    padding: 2.25rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    /* Gives the rows their gentle 3D lean. Bigger = flatter/calmer. */
    perspective: 900px;
  }

  /* The warm glow that follows the mouse across the card — the script
     moves --mx/--my; without the script it simply never appears. */
  .card-candlelight {
    position: absolute;
    inset: 0;
    z-index: 2; /* paints over the rows (it's light falling on them);
                   pointer-events below keeps it from blocking any click */
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.6s ease;
    background: radial-gradient(
      circle 240px at var(--mx, 50%) var(--my, 30%),
      rgba(240, 223, 160, 0.13),
      rgba(201, 168, 76, 0.05) 45%,
      transparent 72%
    );
  }
  .details-card:hover .card-candlelight {
    opacity: 1;
  }

  .details-header {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  /* The little living flame beside the heading (HeroFlame.astro). */
  .details-flame {
    width: 22px;
    flex-shrink: 0;
  }
  /* :global() is needed because .hope-flame lives inside HeroFlame.astro,
     not this file — this nudges its brightness up a touch (1 = normal). */
  .details-flame :global(.hope-flame) {
    --flame-strength: 1.3;
  }

  .details-card h2 {
    font-size: 1.25rem;
    font-weight: 900;
    color: var(--white);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: 0;
  }

  /* EDIT: verse line — the words themselves are in the HTML above. */
  .verse-whisper {
    margin-top: -0.55rem;
    font-size: 0.84rem;
    font-style: italic;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: rgba(240, 223, 160, 0.8);
  }
  /* Where supported, light passes slowly through the words themselves. */
  @supports ((-webkit-background-clip: text) or (background-clip: text)) {
    .verse-whisper {
      background: linear-gradient(
        100deg,
        rgba(201, 168, 76, 0.75) 20%,
        #f6e7b0 50%,
        rgba(201, 168, 76, 0.75) 80%
      );
      background-size: 220% 100%;
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      color: transparent;
      animation: verse-shimmer 8s linear infinite;
    }
  }
  @keyframes verse-shimmer {
    from {
      background-position: 120% 0;
    }
    to {
      background-position: -120% 0;
    }
  }

  .detail-item {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1.1rem;
    padding: 1rem 1.1rem;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.09);
    text-decoration: none;
    transform-style: preserve-3d; /* lets the window pop forward in 3D */
    transition:
      background 0.35s ease,
      border-color 0.35s ease,
      box-shadow 0.35s ease,
      transform 0.28s cubic-bezier(0.2, 0.7, 0.3, 1);
  }

  /* Hover/keyboard-focus: the row lifts and warms. (The script replaces
     the simple lift with the full 3D lean on mouse screens; this is the
     no-JavaScript fallback and the keyboard-focus look.) */
  .detail-item:hover,
  .detail-item:focus-visible {
    background: rgba(74, 144, 196, 0.16);
    border-color: rgba(240, 223, 160, 0.45);
    box-shadow:
      0 10px 30px rgba(5, 12, 26, 0.45),
      0 0 26px rgba(201, 168, 76, 0.16);
    transform: translateY(-3px);
  }
  .detail-item:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
  }

  /* The arched window itself. It sits dim (the brightness filter below)
     until kindled by hover, tap, focus or the scroll-in sequence. */
  .detail-icon {
    position: relative;
    width: 54px;
    height: 64px;
    border-radius: 27px 27px 10px 10px; /* the arch */
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--white);
    border: 1px solid rgba(240, 223, 160, 0.32);
    box-shadow: inset 0 0 14px rgba(5, 12, 26, 0.55);
    overflow: hidden;
    /* EDIT: window motion — how dim the unlit glass sits (1 = full) */
    filter: brightness(0.72) saturate(0.85);
    transition:
      filter 0.45s ease,
      border-color 0.45s ease,
      box-shadow 0.45s ease,
      transform 0.3s ease;
  }

  /* Kindled: glass brightens, frame turns gold, candle-glow spills out,
     and the window floats a little toward you (the translateZ). */
  .detail-item:hover .detail-icon,
  .detail-item:focus-visible .detail-icon,
  .detail-item:active .detail-icon {
    filter: brightness(1.14) saturate(1.18);
    border-color: rgba(240, 223, 160, 0.85);
    box-shadow:
      inset 0 -8px 18px rgba(240, 223, 160, 0.3),
      0 0 22px rgba(201, 168, 76, 0.45);
    transform: translateZ(22px);
  }

  /* The candle inside: a warm bloom rising from the window's base,
     with a gentle flicker once lit. */
  .detail-icon::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      ellipse 70% 55% at 50% 88%,
      rgba(246, 231, 176, 0.55),
      rgba(201, 168, 76, 0.18) 55%,
      transparent 78%
    );
    opacity: 0;
    transition: opacity 0.5s ease;
  }
  .detail-item:hover .detail-icon::after,
  .detail-item:focus-visible .detail-icon::after,
  .detail-item:active .detail-icon::after {
    opacity: 1;
    animation: candle-flicker 2.2s ease-in-out 0.4s infinite;
  }
  @keyframes candle-flicker {
    0%,
    100% {
      opacity: 1;
    }
    28% {
      opacity: 0.82;
    }
    52% {
      opacity: 0.95;
    }
    74% {
      opacity: 0.86;
    }
  }

  /* The gleam that sweeps across the glass the moment it kindles. */
  .detail-icon::before {
    content: '';
    position: absolute;
    inset: -20%;
    pointer-events: none;
    background: linear-gradient(
      115deg,
      transparent 32%,
      rgba(255, 255, 255, 0.32) 50%,
      transparent 68%
    );
    transform: translateX(-130%);
  }
  .detail-item:hover .detail-icon::before,
  .detail-item:focus-visible .detail-icon::before {

  }

  /* ── The kindling: windows light one by one as the card scrolls in ──
     The script adds .will-kindle on load, then .kindled once the card
     is on screen. If JavaScript never runs, neither class appears and
     everything simply shows — nothing is ever hidden for good. */
  .details-card.will-kindle:not(.kindled) .detail-item {
    opacity: 0;
    translate: 0 14px;
  }
  .details-card.kindled .detail-item {
    /* backwards (not forwards) so once each row has arrived, the normal
       hover/kindle styles above take over cleanly */
    animation: row-kindle 0.7s ease backwards;
    animation-delay: calc(var(--i, 0) * 150ms);
  }
  @keyframes row-kindle {
    from {
      opacity: 0;
      translate: 0 14px;

<script>
  // ══════════════════════════════════════════════════════
  //  ROOM HIRE MODE — activated by ?enquiry=room-hire URL param
  // ══════════════════════════════════════════════════════
  (function () {
    const params = new URLSearchParams(window.location.search);
    const isRoomHire = params.get('enquiry') === 'room-hire';

    if (isRoomHire) {
      // 1. Update page heading
      // EDIT: Room hire banner — update heading text here if needed
      const titleEl = document.getElementById('pageTitle');
      const subtitleEl = document.getElementById('pageSubtitle');
      if (titleEl) titleEl.innerHTML = 'Room <span>Hire</span>';
      if (subtitleEl) subtitleEl.textContent = 'Use the form below to make a room hire enquiry';

      // 2. Show the banner
      const banner = document.getElementById('roomHireBanner');
      if (banner) banner.classList.add('visible');

      // 3. Add gold glow to form card
      const formCard = document.getElementById('formCard');
      if (formCard) formCard.classList.add('room-hire-active');

      // 4. Pre-fill subject field
      // EDIT: Room hire pre-fill text — update this string if needed
      const subjectInput = document.getElementById('subject') as HTMLInputElement | null;
      if (subjectInput) {
        subjectInput.value = 'Room Hire Enquiry';
        subjectInput.classList.add('room-hire-prefilled');
      }

      // 5. Update message placeholder with helpful prompt
      const messageInput = document.getElementById('message') as HTMLTextAreaElement | null;
      if (messageInput) {
        messageInput.placeholder =
          'Please include: date required, start and finish time, purpose of hire, number of people attending, and your contact details.';
        messageInput.classList.add('room-hire-textarea');
      }

      // 6. Update form heading
      const formTitle = document.getElementById('formTitle');
      if (formTitle) formTitle.textContent = 'Room Hire Enquiry Form';

      // 7. Scroll form into view smoothly after a brief delay
      setTimeout(() => {
        const formCard2 = document.getElementById('formCard');
        if (formCard2) {
          formCard2.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      }, 350);
    }

    // Dismiss button
    const dismiss = document.getElementById('bannerDismiss');
    const banner2 = document.getElementById('roomHireBanner');
    if (dismiss && banner2) {
      dismiss.addEventListener('click', () => {
        banner2.style.animation = 'none';
        banner2.style.transition = 'opacity 0.3s, max-height 0.4s';
        banner2.style.opacity = '0';
        (banner2.style as any).maxHeight = '0';
        banner2.style.overflow = 'hidden';
        banner2.style.marginBottom = '0';
        setTimeout(() => {
          banner2.style.display = 'none';
        }, 400);
      });
    }
  })();

  // ══════════════════════════════════════════════════════
  //  CONTACT FORM SUBMIT HANDLER
  // ══════════════════════════════════════════════════════
  const form = document.getElementById('contactForm') as HTMLFormElement;
  const btn = document.getElementById('submitBtn') as HTMLButtonElement;
  const toast = document.getElementById('toast') as HTMLElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    const data = {
      fname: (form.elements.namedItem('fname') as HTMLInputElement).value.trim(),
      lname: (form.elements.namedItem('lname') as HTMLInputElement).value.trim(),
      email: (form.elements.namedItem('email') as HTMLInputElement).value.trim(),
      phone: (form.elements.namedItem('phone') as HTMLInputElement).value.trim(),
      subject: (form.elements.namedItem('subject') as HTMLInputElement).value.trim(),
      message: (form.elements.namedItem('message') as HTMLTextAreaElement).value.trim(),
      website: (form.elements.namedItem('website') as HTMLInputElement).value.trim(),
    };

    if (!data.fname || !data.email || !data.message) {
      showToast('Please fill in your name, email and message.', 'error');
      return;
    }

    btn.disabled = true;
    btn.textContent = 'Sending…';

    try {
      // Live contact-form endpoint: API Gateway + Lambda, deployed via
      // Terraform (see terraform/lambda.tf and terraform/api-gateway.tf).
      // CloudFront routes /api/* to it once the live domain is cut over;
      // reachable directly via the CloudFront domain in the meantime.
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (res.ok) {
        // EDIT: success message — the text shown after a message sends successfully
        showToast("✓ Message sent! We'll be in touch soon.", 'success');
        form.reset();
      } else {
        throw new Error('Server error');
      }
    } catch {
      // Fallback for any failure (network issue, server error, etc.):
      // open the visitor's own email app instead, pre-filled with their
      // message, so a bad moment for the API doesn't cost a real enquiry.
      const subject = encodeURIComponent(data.subject || 'Website enquiry');
      const body = encodeURIComponent(
        `Name: ${data.fname} ${data.lname}\nEmail: ${data.email}\nPhone: ${data.phone}\n\n${data.message}`,
      );
      window.location.href = `mailto:info@hopecc.org.uk?subject=${subject}&body=${body}`;
      showToast('Opening your email app instead — something went wrong sending your message.', 'error');
    } finally {
      btn.disabled = false;
      btn.textContent = 'Send Message';
    }
  });

  function showToast(msg: string, type: 'success' | 'error') {
    toast.textContent = msg;
    toast.className = `toast ${type}`;
    toast.style.display = 'block';
    setTimeout(() => {
      toast.style.display = 'none';
    }, 6000);
  }
</script>

<script>
  // ══════════════════════════════════════════════════════
  //  THE CANDLELIT WINDOWS — motion for the Contact Details card.
  //  Decoration only: every link works exactly the same without this
  //  whole block (delete it to switch the motion off — see "EDIT:
  //  window motion" in the <style> block above).
  // ══════════════════════════════════════════════════════
  (function () {
    const card = document.getElementById('detailsCard');
    if (!card) return;

    const items = Array.from(card.querySelectorAll<HTMLElement>('.detail-item'));

    // Number the rows for the one-by-one kindling (done here, not in the
    // HTML, so adding or removing a contact option never needs a number
    // updated by hand).
    items.forEach((el, i) => el.style.setProperty('--i', String(i)));

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // 1 · Kindle the windows, top to bottom, when the card first appears
    if (!reduceMotion && 'IntersectionObserver' in window) {
      card.classList.add('will-kindle');
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            card.classList.add('kindled');
            io.disconnect();
          }
        },
        { threshold: 0.2 },
      );
      io.observe(card);
      // Belt-and-braces: never leave the card unlit, whatever happens
      setTimeout(() => card.classList.add('kindled'), 4000);
    }

    // 2 · Mouse/trackpad screens only from here down (phones get the
    //     kindling above and the tap-glow instead) — and nothing moves
    //     for visitors who've asked their device for reduced motion.
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    if (reduceMotion || !finePointer) return;

    // The candlelight that follows the mouse across the card
    const glow = card.querySelector<HTMLElement>('.card-candlelight');
    if (glow) {
      let glowRaf = 0;
      let gx = 0;
      let gy = 0;
      card.addEventListener('pointermove', (e) => {
        const r = card.getBoundingClientRect();
        gx = e.clientX - r.left;
        gy = e.clientY - r.top;
        if (!glowRaf) {
          glowRaf = requestAnimationFrame(() => {
            glowRaf = 0;
            glow.style.setProperty('--mx', gx + 'px');
            glow.style.setProperty('--my', gy + 'px');
          });
        }
      });
    }

    // Each row leans gently toward the cursor, like a pane catching
    // the light. EDIT: window motion — the two numbers below are the
    // maximum lean in degrees (smaller = calmer, 0 = flat).
    const MAX_LEAN_X = 3; // top/bottom lean
    const MAX_LEAN_Y = 4; // left/right lean
    items.forEach((el) => {
      let leanRaf = 0;
      let lx = 0;
      let ly = 0;
      el.addEventListener('pointermove', (e) => {
        lx = e.clientX;
        ly = e.clientY;
        if (!leanRaf) {
          leanRaf = requestAnimationFrame(() => {
            leanRaf = 0;
            const r = el.getBoundingClientRect();
            const px = (lx - r.left) / r.width - 0.5; // −0.5 … 0.5 across
            const py = (ly - r.top) / r.height - 0.5; // −0.5 … 0.5 down
            // Signs chosen so the corner under the cursor rises toward
            // you (positive rotateX tips the top AWAY, positive rotateY
            // tips the right edge AWAY — hence py straight, px negated).
            const rx = (py * 2 * MAX_LEAN_X).toFixed(2);
            const ry = (-px * 2 * MAX_LEAN_Y).toFixed(2);
            el.style.transform =
              'translateY(-3px) rotateX(' + rx + 'deg) rotateY(' + ry + 'deg)';
          });
        }
      });
      el.addEventListener('pointerleave', () => {
        if (leanRaf) cancelAnimationFrame(leanRaf);
        leanRaf = 0;
        el.style.transform = ''; // hand back to the stylesheet
      });
    });
  })();
</script>

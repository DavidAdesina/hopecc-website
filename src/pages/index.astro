---
// src/pages/index.astro — Hope Community Church homepage
// ─────────────────────────────────────────────────────────────────────────
// WHAT THIS FILE DOES
//   This produces the site's homepage — the hero banner, the service-times
//   strip, the "who we are" section, the three info cards, and the room
//   hire banner at the bottom.
//
// HOW TO MAKE COMMON CHANGES
//   • Page title/meta description → search "EDIT: page title/description"
//   • Hero heading & text         → search "EDIT: hero text"
//   • Service times strip         → edit src/data/services.json (shared
//     with whats-on.astro — one edit updates both pages). Editable via
//     Decap CMS at /admin. Address/parking text stays in this file.
//   • "Who we are" text           → search "EDIT: welcome text"
//   • The three info cards        → search "EDIT: info cards"
//   • Room hire banner text       → search "EDIT: room hire banner"
//   • The hero's moving light      → that all lives in
//     src/components/HeroAtmosphere.astro (the scene + its on/off
//     switches and dials) and src/components/HeroFlame.astro (the
//     flame itself — also the ONE file to update when the new logo
//     arrives from Ian)
//
// This file has two parts, in this order:
//   1. The HTML below   — the words and layout people see on the page,
//      broken into labelled sections (HERO, SERVICE TIMES STRIP, etc.)
//   2. The <style> block at the bottom — colours, spacing and fonts.
//      You shouldn't need to touch the <style> block for normal updates.
// ─────────────────────────────────────────────────────────────────────────
import Layout from '../layouts/Layout.astro';
// The hero's moving light: HeroAtmosphere is the whole scene, HeroFlame is
// just the flame (phones show a small one above the heading). Removing the
// effect = delete these two imports and the two places they're used below.
import HeroAtmosphere from '../components/HeroAtmosphere.astro';
import HeroFlame from '../components/HeroFlame.astro';
import servicesData from '../data/services.json';
const services = servicesData.services;

// Pull just the two time values this page needs — labels below stay
// hardcoded (they're page-specific wording), but the times themselves come
// from the same file whats-on.astro reads, so the two pages can't drift.
const sundayMorning = services.find((s) => s.id === 'sunday-morning');
const sundayEvening = services.find((s) => s.id === 'sunday-evening');

// EDIT: SAFETY NET — do not remove.
// This homepage strip finds services by matching the Internal ID field in
// src/data/services.json (the ids "sunday-morning" and "sunday-evening"
// specifically). If either of those two services is ever deleted, or its
// Internal ID field is retyped, `.find()` above returns undefined — without
// this fallback, reading `.shortTime` on that would crash the ENTIRE site
// build (not just this page). These two lines make sure that instead of a
// broken build, the homepage just shows a safe placeholder.
const sundayMorningTime = sundayMorning?.shortTime ?? 'See What’s On for times';
const sundayEveningTime = sundayEvening?.shortTime ?? 'See What’s On for times';
---

<!-- EDIT: page title/description — shown in browser tabs and search engine results -->
<Layout
  title="Welcome"
  description="Hope Community Church in Hinckley — a warm, welcoming church family. Sunday service at 10:30 am. Christ centred, People focused."
>
  <!-- ============================================================
       HERO
       EDIT: hero text — the heading and text below
  ============================================================ -->
  <section class="hero">
    <!-- All the moving light on the hero (dust, embers, the arched window,
         and — on computers — the big flame on the left). Pure decoration:
         delete this one line and the hero goes back to plain navy. All its
         dials and on/off switches are inside the component itself. -->
    <HeroAtmosphere />

    <div class="hero-inner">
      <!-- On phones only: a small living flame above the heading (computers
           hide this and show the big one on the left instead). -->
      <div class="hero-flame-mobile" aria-hidden="true">
        <HeroFlame />
      </div>

      <p class="eyebrow">Welcome to Hope Community Church · Hinckley</p>
      <!-- The two <span class="hero-line"> wrappers replaced the old <br />
           so each line of the heading can rise in on page load. Edit the
           words exactly as before — just leave the spans around them. -->
      <h1>
        <span class="hero-line"><em>CHRIST</em> centred,</span>
        <span class="hero-line"><em>PEOPLE</em> focused</span>
      </h1>
      <p class="hero-sub">
        We're a warm, friendly church family in Hinckley, Leicestershire. Everyone is welcome —
        wherever you're starting from.
      </p>
      <div class="hero-btns">
        <a href="/contact" class="btn-gold">Plan your visit</a>
      </div>
    </div>
  </section>

  <!-- ============================================================
       SERVICE TIMES STRIP
       EDIT: service times — the four boxes below (times, address, parking)
  ============================================================ -->
  <div class="times-strip">
    <div class="time-item">
      <svg
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="#c9a84c"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        ><circle cx="12" cy="12" r="4"></circle><path
          d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
        ></path></svg
      >
      <div>
        <p class="time-label">Sunday morning service</p>
        <p class="time-val">{sundayMorningTime}</p>
      </div>
    </div>
    <div class="time-item">
      <svg
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="#c9a84c"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg
      >
      <div>
        <p class="time-label">Sunday evening prayer</p>
        <p class="time-val">{sundayEveningTime}</p>
      </div>
    </div>
    <div class="time-item">
      <svg
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="#c9a84c"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        ><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"></path><circle
          cx="12"
          cy="10"
          r="3"></circle></svg
      >
      <div>
        <p class="time-label">Find us</p>
        <p class="time-val">Deveron Way, Hinckley, LE10 0XD</p>
      </div>
    </div>
    <div class="time-item">
      <svg
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="#c9a84c"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        ><rect x="1" y="3" width="15" height="13" rx="2"></rect><path d="M16 8h4l3 3v5h-7V8z"
        ></path><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"
        ></circle></svg
      >
      <div>
        <p class="time-label">Parking</p>
        <p class="time-val">Free car park + on-street</p>
      </div>
    </div>
  </div>

  <!-- ============================================================
       WELCOME / ABOUT
       EDIT: welcome text — the "who we are" heading and paragraph below
  ============================================================ -->
  <section class="welcome">
    <div class="welcome-inner">
      <p class="section-eyebrow">Who we are</p>
      <h2>You don't have to have it all figured out to come</h2>
      <p>
        Hope Community Church is a friendly, Bible-based church family in Hinckley. Whether you're
        new to faith, returning after a long break, or simply curious — you'll find a genuine
        welcome here. We believe in a church where <strong>Christ is at the centre</strong> and <strong>people
        are the focus</strong>. Come as you are.
      </p>
      <a href="/mission" class="btn-navy">More about us</a>
    </div>
  </section>

  <!-- ============================================================
       THREE CARDS
       EDIT: info cards — the heading, and each card's icon/title/text/link
  ============================================================ -->
  <section class="cards-section">
    <div class="cards-inner">
      <p class="section-eyebrow" style="text-align:center;">Get involved</p>
      <h2 class="cards-heading">There's a place for you here</h2>
      <div class="cards-grid">
        <div class="card">
          <div class="card-icon">
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#0d1f3c"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              ><rect x="3" y="4" width="18" height="18" rx="2"></rect><line
                x1="16"
                y1="2"
                x2="16"
                y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line
                x1="3"
                y1="10"
                x2="21"
                y2="10"></line></svg
            >
          </div>
          <h3>What's On</h3>
          <p>
            Sunday services, midweek groups, youth work and community events. See what's happening
            this week.
          </p>
          <a href="/whats-on" class="card-link">
            See events
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"></path></svg
            >
          </a>
        </div>

        <div class="card">
          <div class="card-icon">
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#0d1f3c"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg
            >
          </div>
          <h3>Watch &amp; Listen</h3>
          <p>
            Catch up on recent sermons or join our live stream every Sunday morning at 10:30 am.
          </p>
          <a href="/watch-listen" class="card-link">
            Watch now
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"></path></svg
            >
          </a>
        </div>

        <div class="card">
          <div class="card-icon">
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#0d1f3c"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              ><path
                d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"
              ></path></svg
            >
          </div>
          <h3>Our Mission</h3>
          <p>
            Christ centred and people focused — we're committed to serving Hinckley and sharing the
            love of Jesus.
          </p>
          <a href="/mission" class="card-link">
            Learn more
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"></path></svg
            >
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       ROOM HIRE CTA BANNER
       EDIT: room hire banner — the heading and text below
  ============================================================ -->
  <section class="hire-banner">
    <div class="hire-inner">
      <div>
        <p class="section-eyebrow" style="color: var(--gold-light);">Did you know?</p>
        <h2>Our facilities are available to hire</h2>
        <p>
          We have flexible meeting and event spaces available for community groups, businesses and
          private hire in Hinckley.
        </p>
      </div>
      <a href="/room-hire" class="btn-gold">Find out more</a>
    </div>
  </section>
</Layout>

<style>
  /* ---- Shared ---- */
  .section-eyebrow {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--blue);
    margin-bottom: 14px;
  }

  /* ---- Hero ---- */
  .hero {
    /* position/overflow let the atmosphere live inside the hero and be
       trimmed neatly at its edges; the layered background turns the flat
       navy into a softly lit room. The words and spacing are unchanged. */
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(130% 100% at 50% -10%, var(--navy-mid) 30%, var(--navy) 78%),
      var(--navy);
    color: #fff;
    padding: 88px 28px 96px;
    text-align: center;
    /* Give the light some room on big screens: the hero grows toward
       filling the window (minus roughly the menu bar + times strip).
       The first line is a fallback for older browsers. */
    min-height: max(540px, calc(100vh - 152px));
    min-height: max(540px, calc(100svh - 152px));
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-inner {
    max-width: 680px;
    margin: 0 auto;
    /* keeps the words stacked above every layer of light */
    position: relative;
    z-index: 8;
  }

  .eyebrow {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 18px;
    /* on page load: fades in while the letters draw together */
    animation: eyebrow-in 1s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  @keyframes eyebrow-in {
    from {
      opacity: 0;
      letter-spacing: 0.5em;
      filter: blur(3px);
    }
    to {
      opacity: 1;
      letter-spacing: 0.22em;
      filter: blur(0);
    }
  }

  .hero h1 {
    font-size: clamp(36px, 6vw, 52px);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin-bottom: 20px;
  }

  /* Each heading line rises in and sharpens on page load, one after the
     other — then everything holds still. */
  .hero h1 .hero-line {
    display: block;
    animation: hero-line-in 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .hero h1 .hero-line + .hero-line {
    animation-delay: 0.16s;
  }

  @keyframes hero-line-in {
    from {
      opacity: 0;
      transform: translateY(22px);
      filter: blur(7px);
    }
    to {
      opacity: 1;
      transform: none;
      filter: blur(0);
    }
  }

  .hero h1 em {
    font-style: normal;
    color: var(--blue-light);
    /* One pass of light travels through this word shortly after the page
       opens, then it settles back to the normal blue. The gradient is
       painted "through" the letters themselves. Two words carry this
       treatment now (CHRIST, PEOPLE) — the rule just below staggers the
       second one so the two passes read as a sequence, not one flash. */
    background: linear-gradient(
      100deg,
      var(--blue-light) 0%,
      var(--blue-light) 40%,
      #ffffff 50%,
      var(--gold-light) 54%,
      var(--blue-light) 64%,
      var(--blue-light) 100%
    );
    background-size: 300% 100%;
    background-position: 100% 0;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: hero-word-shimmer 2.4s ease-in-out 2.1s 1 both;
  }

  .hero h1 .hero-line + .hero-line em {
    animation-delay: 2.3s;
  }

  @keyframes hero-word-shimmer {
    from {
      background-position: 100% 0;
    }
    to {
      background-position: 0% 0;
    }
  }

  .hero-sub {
    font-size: 17px;
    color: rgba(255, 255, 255, 0.72);
    max-width: 440px;
    margin: 0 auto 38px;
    line-height: 1.75;
    animation: hero-line-in 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) 0.34s both;
  }

  .hero-btns {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
    animation: hero-line-in 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) 0.5s both;
  }

  /* In the hero only, the gold button also lifts and glows on hover
     (its colours and behaviour everywhere else are untouched). */
  .hero-btns .btn-gold {
    transition:
      background 0.15s,
      transform 0.2s,
      box-shadow 0.3s;
  }

  .hero-btns .btn-gold:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 32px rgba(201, 168, 76, 0.4);
  }

  /* The small phone flame: hidden on computers, shown on narrow screens
     (the atmosphere's big flame is hidden on phones at the same width). */
  .hero-flame-mobile {
    display: none;
  }

  @media (max-width: 940px) {
    .hero-flame-mobile {
      display: block;
      width: 92px;
      margin: 0 auto 14px;
      /* a touch brighter than the big faint one on computers */
      --flame-strength: 1.3;
      animation: hero-line-in 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }

    .hero {
      min-height: max(600px, calc(100vh - 210px));
      min-height: max(600px, calc(100svh - 210px));
    }
  }

  /* For anyone whose device asks for reduced motion: no entrances, no
     shimmer — the finished page simply appears, complete and still. */
  @media (prefers-reduced-motion: reduce) {
    .eyebrow,
    .hero h1 .hero-line,
    .hero-sub,
    .hero-btns,
    .hero-flame-mobile {
      animation: none;
    }

    .hero h1 em {
      background: none;
      -webkit-text-fill-color: currentColor;
      animation: none;
    }
  }

  .btn-gold {
    background: var(--gold);
    color: var(--navy);
    text-decoration: none;
    padding: 13px 28px;
    border-radius: 5px;
    font-size: 13.5px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: background 0.15s;
  }

  .btn-gold:hover {
    background: #b8943d;
    color: #fff;
  }

  .btn-ghost {
    background: transparent;
    color: #fff;
    text-decoration: none;
    border: 1.5px solid rgba(255, 255, 255, 0.35);
    padding: 13px 28px;
    border-radius: 5px;
    font-size: 13.5px;
    font-weight: 700;
    letter-spacing: 0.04em;
    transition:
      border-color 0.15s,
      background 0.15s;
  }

  .btn-ghost:hover {
    border-color: rgba(255, 255, 255, 0.7);
    background: rgba(255, 255, 255, 0.06);
  }

  /* ---- Times strip ---- */
  .times-strip {
    background: var(--navy);
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
  }

  .time-item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 20px 32px;
    border-right: 1px solid rgba(255, 255, 255, 0.1);
  }

  .time-item:last-child {
    border-right: none;
  }

  .time-label {
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--blue-light);
    margin-bottom: 3px;
  }

  .time-val {
    font-size: 15px;
    font-weight: 800;
    color: #ffffff;
  }

  /* ---- Welcome ---- */
  .welcome {
    padding: 88px 28px;
    text-align: center;
  }

  .welcome-inner {
    max-width: 640px;
    margin: 0 auto;
  }

  .welcome h2 {
    font-size: clamp(26px, 4vw, 34px);
    font-weight: 800;
    color: var(--navy);
    margin-bottom: 18px;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .welcome p {
    font-size: 16.5px;
    color: var(--text-mid);
    line-height: 1.8;
    margin-bottom: 30px;
  }

  .btn-navy {
    display: inline-block;
    background: var(--navy);
    color: #fff;
    text-decoration: none;
    padding: 13px 28px;
    border-radius: 5px;
    font-size: 13.5px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: background 0.15s;
  }

  .btn-navy:hover {
    background: var(--navy-mid);
  }

  /* ---- Cards ---- */
  .cards-section {
    background: var(--blue-pale);
    padding: 72px 28px;
  }

  .cards-inner {
    max-width: 1100px;
    margin: 0 auto;
  }

  .cards-heading {
    font-size: clamp(24px, 3.5vw, 30px);
    font-weight: 800;
    color: var(--navy);
    letter-spacing: -0.01em;
    text-align: center;
    margin-bottom: 40px;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .card {
    background: #ffffff;
    border-radius: 10px;
    padding: 30px 24px;
    border-top: 3px solid var(--blue);
  }

  .card-icon {
    width: 44px;
    height: 44px;
    background: var(--blue-pale);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
  }

  .card h3 {
    font-size: 17px;
    font-weight: 800;
    color: var(--navy);
    margin-bottom: 8px;
    letter-spacing: 0.01em;
  }

  .card p {
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.65;
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-top: 16px;
    font-size: 12px;
    font-weight: 700;
    color: var(--blue);
    text-decoration: none;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: gap 0.15s;
  }

  .card-link:hover {
    gap: 8px;
  }

  /* ---- Room hire banner ---- */
  .hire-banner {
    background: var(--navy-mid);
    color: #fff;
    padding: 64px 28px;
  }

  .hire-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
  }

  .hire-inner h2 {
    font-size: clamp(22px, 3vw, 28px);
    font-weight: 800;
    letter-spacing: -0.01em;
    margin-bottom: 10px;
  }

  .hire-inner p {
    font-size: 15.5px;
    color: rgba(255, 255, 255, 0.7);
    max-width: 520px;
    line-height: 1.7;
  }

  /* ---- Responsive ---- */
  @media (max-width: 860px) {
    .cards-grid {
      grid-template-columns: 1fr 1fr;
    }

    .time-item {
      padding: 16px 20px;
    }
  }

  @media (max-width: 560px) {
    .cards-grid {
      grid-template-columns: 1fr;
    }

    .hire-inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
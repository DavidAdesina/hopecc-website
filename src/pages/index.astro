  <!-- ============================================================
       ROOM HIRE CTA BANNER
       EDIT: room hire banner — the heading and text below
  ============================================================ -->
  <section class="hire-banner">
    <div class="hire-inner">
      <div>
        <p class="section-eyebrow" style="color: var(--gold-light);">Did you know?</p>
        <h2>Our facilities are available to hire</h2>
        <p>
          We have flexible meeting and event spaces available for community groups, businesses and
          private hire in Hinckley.
        </p>
      </div>
      <a href="/room-hire" class="btn-gold">Find out more</a>
    </div>
  </section>
  <!-- EDIT: hero photo — the gentle 3D lean. On computers only, the framed
       photo leans a few degrees toward the mouse as it moves, the same way
       the contact page's windows do. Purely decorative and self-contained:
       delete this whole <script> block and the photo simply holds still.
       It switches itself off on touch screens and for visitors who ask
       their device for reduced motion. -->
  <script>
    const heroPhoto = document.querySelector('.hero-photo');
    const heroPhotoCard = document.querySelector('.hero-photo-card');
    const heroFinePointer = window.matchMedia('(pointer: fine)').matches;
    const heroMotionOk = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (heroPhoto instanceof HTMLElement && heroPhotoCard instanceof HTMLElement && heroFinePointer && heroMotionOk) {
      let rafId = 0;
      let leanX = 0;
      let leanY = 0;

      heroPhoto.addEventListener('pointermove', (e) => {
        const box = heroPhoto.getBoundingClientRect();
        const px = (e.clientX - box.left) / box.width - 0.5;
        const py = (e.clientY - box.top) / box.height - 0.5;
        leanY = px * 7; // side-to-side lean, in degrees (±3.5° at the edges)
        leanX = py * -5; // up-and-down lean, in degrees (±2.5° at the edges)
        if (!rafId) {
          rafId = requestAnimationFrame(() => {
            rafId = 0;
            heroPhotoCard.style.transform =
              'rotateY(' + leanY.toFixed(2) + 'deg) rotateX(' + leanX.toFixed(2) + 'deg)';
          });
        }
      });

      heroPhoto.addEventListener('pointerleave', () => {
        if (rafId) cancelAnimationFrame(rafId);
        rafId = 0;
        heroPhotoCard.style.transform = '';
      });
    }
  </script>
</Layout>

<style>
  /* ---- Shared ---- */
  .section-eyebrow {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--blue);
    margin-bottom: 14px;
  }

  /* ---- Hero ---- */
  .hero {
    /* position/overflow let the backdrop live inside the hero and be
       trimmed neatly at its edges; the gradient is the fallback colour
       for the instant before the backdrop photo loads. */
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(130% 100% at 50% -10%, var(--navy-mid) 30%, var(--navy) 78%),
      var(--navy);
    color: #fff;
    padding: 88px 28px 96px;
    /* Give the scene some room on big screens: the hero grows toward
       filling the window (minus roughly the menu bar + times strip).
       The first line is a fallback for older browsers. */
    min-height: max(540px, calc(100vh - 152px));
    min-height: max(540px, calc(100svh - 152px));
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* EDIT: hero photo — the backdrop. The church's own photo, blurred into
     a wash of warm brick and evening sky behind everything. The heavy
     blur also means the modest photo file can fill any screen without
     ever looking pixelated. */
  .hero-backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero-backdrop img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(38px) saturate(1.3) brightness(0.85);
    /* scaled up so the blur never shows a soft edge at the borders, then
       drifting very slowly — one full drift takes 36 seconds */
    transform: scale(1.16);
    animation: backdrop-drift 36s ease-in-out infinite alternate;
  }
  @keyframes backdrop-drift {
    from {
      transform: scale(1.16) translate(0, 0);
    }
    to {
      transform: scale(1.26) translate(-1.6%, -1.2%);
    }
  }
  /* the navy wash over the blurred photo: darkest on the left (behind
     the words, so they stay easy to read), lighter on the right (so the
     warm colour glows through around the framed photo), and fading to
     near-solid navy at the top and bottom so the menu bar and times
     strip join on seamlessly */
  .hero-backdrop-tint {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to bottom,
        rgba(13, 31, 60, 0.66) 0%,
        rgba(13, 31, 60, 0.16) 24%,
        rgba(13, 31, 60, 0.18) 62%,
        rgba(13, 31, 60, 0.9) 100%
      ),
      linear-gradient(
        97deg,
        rgba(13, 31, 60, 0.96) 0%,
        rgba(13, 31, 60, 0.88) 38%,
        rgba(13, 31, 60, 0.62) 68%,
        rgba(13, 31, 60, 0.44) 100%
      );
  }

  .hero-inner {
    max-width: 1180px;
    width: 100%;
    margin: 0 auto;
    /* keeps the words and photo stacked above the backdrop */
    position: relative;
    z-index: 8;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 520px);
    gap: clamp(40px, 6vw, 90px);
    align-items: center;
  }

  .hero-copy {
    text-align: left;
    max-width: 620px;
  }

  .eyebrow {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 18px;
    /* on page load: fades in while the letters draw together */
    animation: eyebrow-in 1s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  @keyframes eyebrow-in {
    from {
      opacity: 0;
      letter-spacing: 0.5em;
      filter: blur(3px);
    }
    to {
      opacity: 1;
      letter-spacing: 0.22em;
      filter: blur(0);
    }
  }

  .hero h1 {
    font-size: clamp(36px, 6vw, 52px);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin-bottom: 20px;
  }

  /* Each heading line rises in and sharpens on page load, one after the
     other — then everything holds still. */
  .hero h1 .hero-line {
    display: block;
    animation: hero-line-in 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  .hero h1 .hero-line + .hero-line {
    animation-delay: 0.16s;
  }

  @keyframes hero-line-in {
    from {
      opacity: 0;
      transform: translateY(22px);
      filter: blur(7px);
    }
    to {
      opacity: 1;
      transform: none;
      filter: blur(0);
    }
  }

  .hero h1 em {
    font-style: normal;
    color: var(--blue-light);
    /* One pass of light travels through this word shortly after the page
       opens, then it settles back to the normal blue. The gradient is
       painted "through" the letters themselves. Two words carry this
       treatment now (CHRIST, PEOPLE) — the rule just below staggers the
       second one so the two passes read as a sequence, not one flash. */
    background: linear-gradient(
      100deg,
      var(--blue-light) 0%,
      var(--blue-light) 40%,
      #ffffff 50%,
      var(--gold-light) 54%,
      var(--blue-light) 64%,
      var(--blue-light) 100%
    );
    background-size: 300% 100%;
    background-position: 100% 0;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: hero-word-shimmer 2.4s ease-in-out 2.1s 1 both;
  }

  .hero h1 .hero-line + .hero-line em {
    animation-delay: 2.3s;
  }

  @keyframes hero-word-shimmer {
    from {
      background-position: 100% 0;
    }
    to {
      background-position: 0% 0;
    }
  }

  .hero-sub {
    font-size: 17px;
    color: rgba(255, 255, 255, 0.72);
    max-width: 470px;
    margin: 0 0 38px;
    line-height: 1.75;
    animation: hero-line-in 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) 0.34s both;
  }

  .hero-btns {
    display: flex;
    gap: 12px;
    justify-content: flex-start;
    flex-wrap: wrap;
    animation: hero-line-in 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) 0.5s both;
  }

  /* In the hero only, the gold button also lifts and glows on hover
     (its colours and behaviour everywhere else are untouched). */
  .hero-btns .btn-gold {
    transition:
      background 0.15s,
      transform 0.2s,
      box-shadow 0.3s;
  }

  .hero-btns .btn-gold:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 32px rgba(201, 168, 76, 0.4);
  }

  /* EDIT: hero photo — the framed photo itself. */
  .hero-photo {
    position: relative;
    margin: 0;
    width: 100%;
    /* the source photo is 640px wide — never stretch it much past that */
    max-width: 560px;
    justify-self: end;
    /* the 3D "stage" for the gentle mouse-lean (script at the bottom) */
    perspective: 950px;
    animation: hero-photo-in 1s cubic-bezier(0.2, 0.7, 0.2, 1) 0.55s both;
  }
  @keyframes hero-photo-in {
    from {
      opacity: 0;
      transform: translateY(26px) scale(0.97);
      filter: blur(8px);
    }
    to {
      opacity: 1;
      transform: none;
      filter: blur(0);
    }
  }
  /* a soft, slowly breathing circle of golden light behind the frame */
  .hero-photo-glow {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 130%;
    aspect-ratio: 1;
    margin-left: -65%;
    margin-top: -65%;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(240, 223, 160, 0.2) 0%,
      rgba(201, 168, 76, 0.08) 46%,
      transparent 70%
    );
    animation: photo-glow-breathe 8s ease-in-out infinite;
    pointer-events: none;
  }
  @keyframes photo-glow-breathe {
    0%,
    100% {
      opacity: 0.65;
      transform: scale(0.97);
    }
    50% {
      opacity: 1;
      transform: scale(1.03);
    }
  }
  .hero-photo-card {
    position: relative;
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid rgba(240, 223, 160, 0.5);
    box-shadow:
      0 24px 60px rgba(3, 9, 20, 0.5),
      0 0 44px 6px rgba(201, 168, 76, 0.16);
    transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .hero-photo-card img {
    display: block;
    width: 100%;
    height: auto;
    /* EDIT: hero photo — the photo's tone. Deliberately just a whisper
       of warmth, so the building reads clearly and true-to-life. */
    filter: saturate(1.05) sepia(0.08) contrast(1.04) brightness(1.02);
  }
  /* one soft pass of light sweeps across the photo shortly after it
     appears, then never again — like evening sun catching the glass */
  .hero-photo-card::after {
    content: '';
    position: absolute;
    inset: -20% -35%;
    background: linear-gradient(
      115deg,
      transparent 40%,
      rgba(255, 255, 255, 0.14) 50%,
      rgba(240, 223, 160, 0.1) 55%,
      transparent 65%
    );
    transform: translateX(-130%);
    animation: photo-sheen 1.6s ease-in-out 2.6s 1 both;

---
// src/pages/index.astro — Hope Community Church homepage
// ─────────────────────────────────────────────────────────────────────────
// WHAT THIS FILE DOES
//   This produces the site's homepage — the hero banner, the service-times
//   strip, the "who we are" section, the three info cards, and the room
//   hire banner at the bottom.
//
// HOW TO MAKE COMMON CHANGES
//   • Page title/meta description → search "EDIT: page title/description"
//   • Hero heading & text         → search "EDIT: hero text"
//   • Service times strip         → edit src/data/services.json (shared
//     with whats-on.astro — one edit updates both pages). Editable via
//     Decap CMS at /admin. Address/parking text stays in this file.
//   • "Who we are" text           → search "EDIT: welcome text"
//   • The three info cards        → search "EDIT: info cards"
//   • Room hire banner text       → search "EDIT: room hire banner"
//   • The hero photo & backdrop   → search "EDIT: hero photo". The framed
//     photo, its caption, and the blurred colour-wash behind the whole
//     hero all read from ONE file (public/images/church-photo.jpg) —
//     swap that single image to change the entire scene at once.
//     (HeroFlame.astro still exists for the contact page, and is still
//     the ONE file to update when the new logo arrives from Ian.)
//
// This file has two parts, in this order:
//   1. The HTML below   — the words and layout people see on the page,
//      broken into labelled sections (HERO, SERVICE TIMES STRIP, etc.)
//   2. The <style> block at the bottom — colours, spacing and fonts.
//      You shouldn't need to touch the <style> block for normal updates.
// ─────────────────────────────────────────────────────────────────────────
import Layout from '../layouts/Layout.astro';
import servicesData from '../data/services.json';
const services = servicesData.services;

// Pull just the two time values this page needs — labels below stay
// hardcoded (they're page-specific wording), but the times themselves come
// from the same file whats-on.astro reads, so the two pages can't drift.
const sundayMorning = services.find((s) => s.id === 'sunday-morning');
const sundayEvening = services.find((s) => s.id === 'sunday-evening');

// EDIT: SAFETY NET — do not remove.
// This homepage strip finds services by matching the Internal ID field in
// src/data/services.json (the ids "sunday-morning" and "sunday-evening"
// specifically). If either of those two services is ever deleted, or its
// Internal ID field is retyped, `.find()` above returns undefined — without
// this fallback, reading `.shortTime` on that would crash the ENTIRE site
// build (not just this page). These two lines make sure that instead of a
// broken build, the homepage just shows a safe placeholder.
const sundayMorningTime = sundayMorning?.shortTime ?? 'See What’s On for times';
const sundayEveningTime = sundayEvening?.shortTime ?? 'See What’s On for times';
---

<!-- EDIT: page title/description — shown in browser tabs and search engine results -->
<Layout
  title="Welcome"
  description="Hope Community Church in Hinckley — a warm, welcoming church family. Sunday service at 10:30 am. Christ centred, People focused."
>
  <!-- ============================================================
       HERO
       EDIT: hero text — the heading and text below
       EDIT: hero photo — the photo appears twice on purpose: once
       blurred into a soft wash of colour behind the whole hero, and
       once sharp inside the gold frame. Both read the same file
       (public/images/church-photo.jpg), so replacing that ONE image
       updates the entire scene in one go.
  ============================================================ -->
  <section class="hero">
    <!-- The backdrop: the church's own photo, blurred into ambient
         colour and drifting very slowly. Pure decoration — the sharp,
         readable copy of the photo is the framed one further down. -->
    <div class="hero-backdrop" aria-hidden="true">
      <img src="/images/church-photo.jpg" alt="" loading="eager" />
      <div class="hero-backdrop-tint"></div>
    </div>

    <div class="hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">Welcome to Hope Community Church · Hinckley</p>
        <!-- The two <span class="hero-line"> wrappers replaced the old <br />
             so each line of the heading can rise in on page load. Edit the
             words exactly as before — just leave the spans around them. -->
        <h1>
          <span class="hero-line"><em>CHRIST</em> centred,</span>
          <span class="hero-line"><em>PEOPLE</em> focused</span>
        </h1>
        <p class="hero-sub">
          We're a warm, friendly church family in Hinckley, Leicestershire. Everyone is welcome —
          wherever you're starting from.
        </p>
        <div class="hero-btns">
          <a href="/contact" class="btn-gold">Plan your visit</a>
        </div>
      </div>

      <!-- The framed photo. On computers it sits beside the words and
           leans very gently toward the mouse (see the small script at the
           bottom of this file); on phones it sits just below them. -->
      <figure class="hero-photo">
        <div class="hero-photo-glow" aria-hidden="true"></div>
        <div class="hero-photo-card">
          <img
            src="/images/church-photo.jpg"
            alt="The Hope Community Church building on Deveron Way, Hinckley"
            width="640"
            height="480"
            loading="eager"
          />
          <!-- EDIT: hero photo — the little caption on the photo -->
          <figcaption class="hero-photo-caption">Our home on Deveron Way!</figcaption>
        </div>
      </figure>
    </div>
  </section>


        fill="none"
        stroke="#c9a84c"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        ><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"></path><circle
          cx="12"
          cy="10"
          r="3"></circle></svg
      >
      <div>
        <p class="time-label">Find us</p>
        <p class="time-val">Deveron Way, Hinckley, LE10 0XD</p>
      </div>
    </div>
    <div class="time-item">
      <svg
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="#c9a84c"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        ><rect x="1" y="3" width="15" height="13" rx="2"></rect><path d="M16 8h4l3 3v5h-7V8z"
        ></path><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"
        ></circle></svg
      >
      <div>
        <p class="time-label">Parking</p>
        <p class="time-val">Free car park + on-street</p>
      </div>
    </div>
  </div>

  <!-- ============================================================
       WELCOME / ABOUT
       EDIT: welcome text — the "who we are" heading and paragraph below
  ============================================================ -->
  <section class="welcome">
    <div class="welcome-inner">
      <p class="section-eyebrow">Who we are</p>
      <h2>You don't have to have it all figured out to come</h2>
      <p>
        Hope Community Church is a friendly, Bible-based church family in Hinckley. Whether you're
        new to faith, returning after a long break, or simply curious — you'll find a genuine
        welcome here. We believe in a church where <strong>Christ is at the centre</strong> and <strong>people
        are the focus</strong>. Come as you are.
      </p>
      <a href="/mission" class="btn-navy">More about us</a>
    </div>
  </section>

  <!-- ============================================================
       THREE CARDS
       EDIT: info cards — the heading, and each card's icon/title/text/link
  ============================================================ -->
  <section class="cards-section">
    <div class="cards-inner">
      <p class="section-eyebrow" style="text-align:center;">Get involved</p>
      <h2 class="cards-heading">There's a place for you here</h2>
      <div class="cards-grid">
        <div class="card">
          <div class="card-icon">
            <svg
              width="22"

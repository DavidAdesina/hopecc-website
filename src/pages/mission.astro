---
// src/pages/mission.astro — Hope Community Church
// ─────────────────────────────────────────────────────────────────────────
// WHAT THIS FILE DOES
//   The Mission overview route. All the real content (hero, "What We
//   Believe About Mission" intro, India/Romania summary cards) lives in
//   src/components/MissionOverviewContent.astro — this file just checks
//   whether the page is switched on in the CMS (Website Sections →
//   Mission — Overview page in Decap, backed by
//   src/data/page-visibility.json) and shows either that real content or
//   the "back soon" notice. This file itself should never need editing —
//   it never has to move, and it never holds real content to lose.
// ─────────────────────────────────────────────────────────────────────────
import Layout from '../layouts/Layout.astro';
import PageUnavailable from '../components/PageUnavailable.astro';
import MissionOverviewContent from '../components/MissionOverviewContent.astro';
import { getPageStatus } from '../lib/page-visibility.js';

const { enabled, message } = getPageStatus('mission-overview');
---

<Layout title="Mission | Hope Community Church" noindex={!enabled}>
  {enabled ? <MissionOverviewContent /> : <PageUnavailable message={message} />}
</Layout>

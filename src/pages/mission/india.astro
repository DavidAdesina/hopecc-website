---
// src/pages/mission/india.astro — Hope Community Church
// ─────────────────────────────────────────────────────────────────────────
// WHAT THIS FILE DOES
//   The India mission story route. All the real content (Prabha & Mary,
//   Lonavala) lives in src/components/MissionIndiaContent.astro — this
//   file just checks whether the page is switched on in the CMS (Website
//   Sections → Mission — India page in Decap, backed by
//   src/data/page-visibility.json) and shows either that real content or
//   the "back soon" notice. This file itself should never need editing —
//   it never has to move, and it never holds real content to lose.
// ─────────────────────────────────────────────────────────────────────────
import Layout from '../../layouts/Layout.astro';
import PageUnavailable from '../../components/PageUnavailable.astro';
import MissionIndiaContent from '../../components/MissionIndiaContent.astro';
import { getPageStatus } from '../../lib/page-visibility.js';

const { enabled, message } = getPageStatus('mission-india');
---

<Layout title="India Mission — Prabha & Mary | Hope Community Church" noindex={!enabled}>
  {enabled ? <MissionIndiaContent /> : <PageUnavailable message={message} />}
</Layout>

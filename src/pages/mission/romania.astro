<!-- ══════════════════════════════════════════════════
     CAROUSEL SCRIPT
     Auto-advances the village photo carousel every 3.5 seconds.
     Clicking a dot jumps to that slide.
     Pauses when the user hovers over the carousel.

     This script counts the photos itself and builds one dot per photo,
     so the photos (above) are the only list anyone needs to edit —
     there's no separate dot list to keep in sync by hand.
══════════════════════════════════════════════════ -->
<script>
  (function () {
    const track = document.getElementById('villageTrack');
    const slides = track.querySelectorAll('.carousel-slide');
    const dotsHolder = document.getElementById('villageDots');
    const total = slides.length;
    let current = 0;
    let timer;

    // Build one dot per photo, in order, and remember them in a list
    // so the rest of the script can use them the same way as before.
    const dots = [];
    for (let i = 0; i < total; i++) {
      const dot = document.createElement('button');
      dot.className = 'dot' + (i === 0 ? ' active' : '');
      dot.dataset.index = i;
      dotsHolder.appendChild(dot);
      dots.push(dot);
    }

    function goTo(index) {
      current = (index + total) % total;
      track.style.transform = `translateX(-${current * 100}%)`;
      dots.forEach((d, i) => d.classList.toggle('active', i === current));
    }

    function next() {
      goTo(current + 1);
    }

    function startAuto() {
      timer = setInterval(next, 3500);
    }
    function stopAuto() {
      clearInterval(timer);
    }

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        stopAuto();
        goTo(parseInt(dot.dataset.index));
        startAuto();
      });
    });

    // Pause on hover
    const carousel = track.closest('.village-carousel');
    carousel.addEventListener('mouseenter', stopAuto);
    carousel.addEventListener('mouseleave', startAuto);

    startAuto();
  })();
</script>

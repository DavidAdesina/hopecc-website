---
// src/pages/mission/romania.astro — Hope Community Church
// ─────────────────────────────────────────────────────────────────────────
// WHAT THIS FILE DOES
//   The Romania mission story route. All the real content (Mick &
//   Lorraine Smith, Satu-Nou) lives in
//   src/components/MissionRomaniaContent.astro — this file just checks
//   whether the page is switched on in the CMS (Website Sections →
//   Mission — Romania page in Decap, backed by
//   src/data/page-visibility.json) and shows either that real content or
//   the "back soon" notice. This file itself should never need editing —
//   it never has to move, and it never holds real content to lose.
// ─────────────────────────────────────────────────────────────────────────
import Layout from '../../layouts/Layout.astro';
import PageUnavailable from '../../components/PageUnavailable.astro';
import MissionRomaniaContent from '../../components/MissionRomaniaContent.astro';
import { getPageStatus } from '../../lib/page-visibility.js';

const { enabled, message } = getPageStatus('mission-romania');
---

<Layout title="Romania Mission — Mick & Lorraine Smith | Hope Community Church" noindex={!enabled}>
  {enabled ? <MissionRomaniaContent /> : <PageUnavailable message={message} />}
</Layout>

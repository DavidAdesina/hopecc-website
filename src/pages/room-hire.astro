---
// src/pages/room-hire.astro — Hope Community Church
// ─────────────────────────────────────────────────────────────────────────
// WHAT THIS FILE DOES
//   This page has no content of its own. It exists only so that
//   /room-hire works as a link — a visitor who lands here is instantly
//   sent on to the Contact page with ?enquiry=room-hire added to the
//   address, which automatically shows the Room Hire banner and
//   pre-fills the subject field on the contact form there.
//
// HOW TO MAKE COMMON CHANGES
//   There's nothing to edit in this file. All the actual Room Hire
//   wording (banner text, checklist, pre-filled subject) lives in
//   contact.astro — search that file for "EDIT: Room hire".
// ─────────────────────────────────────────────────────────────────────────
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content="0;url=/contact/?enquiry=room-hire" />
    <title>Room Hire — Hope Community Church</title>
    <style>
      body {
        background: #0d1f3c;
        color: #ffffff;
        font-family: 'Nunito', sans-serif;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        margin: 0;
      }
    </style>
  </head>
  <body>
    <script>
      // Instant JS redirect (meta refresh is fallback)
      window.location.replace('/contact/?enquiry=room-hire');
    </script>
    <p>Redirecting to Room Hire enquiry…</p>
  </body>
</html>

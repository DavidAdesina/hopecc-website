---
import Layout from '../layouts/Layout.astro';

const pageTitle = "Watch & Listen | Hope Community Church";
const pageDescription = "Watch sermons, catch up on recent talks, and join our Sunday live stream at Hope Community Church, Hinckley.";

/*
  ── DEV NOTES ──
  Replace these placeholder values once Ian provides them:
  - YOUTUBE_CHANNEL_ID   → found in YouTube Studio → Customisation → Basic info
  - YOUTUBE_PLAYLIST_ID  → the "Sermons" playlist ID from the channel
  - LIVE_STREAM_VIDEO_ID → the recurring live stream URL (if they use one)
                           or leave as is — the channel live tab link works too.

  Sermon data below is dummy content. Once Ian gives real YouTube links,
  replace `videoId` with the 11-char ID from youtube.com/watch?v=XXXXXXXXXXX
*/

const YOUTUBE_CHANNEL_ID = 'CHANNEL_ID_HERE';   // ← replace
const YOUTUBE_PLAYLIST_ID = 'PLAYLIST_ID_HERE'; // ← replace

// Sample sermons — replace with real data from Ian / YouTube playlist API later
const featuredSermons = [
  {
    videoId: 'dQw4w9WgXcQ', // placeholder — replace with real video ID
    title: 'Latest sermon title here',
    speaker: 'Speaker name',
    date: 'Coming soon',
    series: 'Sermon series name',
    placeholder: true,
  },
];
---

<Layout title={pageTitle} description={pageDescription}>

  <!-- PAGE HERO -->
  <section class="page-hero">
    <div class="page-hero__inner">
      <p class="page-hero__eyebrow">Sermons &amp; Streaming</p>
      <h1 class="page-hero__title">Watch &amp; Listen</h1>
      <p class="page-hero__subtitle">
        Something exciting is on its way. We're building a home for Hope's sermons,
        talks, and live Sunday services — watch this space.
      </p>
    </div>
  </section>

<!-- COMING SOON BANNER -->
  <section class="coming-banner">
    <div class="container">
      <div class="coming-banner__inner">
        <div class="coming-banner__icon" aria-hidden="true">🔥</div>
        <div class="coming-banner__text">
          <h2>Live streaming — coming soon</h2>
          <p>
            We're working on bringing our Sunday morning services online.
            When it launches, you'll be able to join us live right here — every Sunday at <strong>10:30 am</strong>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- COMING SOON FEATURE SHOWCASE -->
  <section class="showcase-section">
    <div class="container">

      <div class="showcase-intro">
        <p class="showcase-eyebrow">Under Construction</p>
        <h2 class="showcase-title">We're building something worth watching</h2>
        <p class="showcase-subtitle">
          Hope Community Church is preparing to bring its Sunday services, sermon archive,
          and live worship straight to your screen. Here's what's coming.
        </p>
      </div>

      <!-- FEATURE CARDS -->
      <div class="feature-grid">

        <div class="feature-card feature-card--live">
          <div class="feature-card__icon" aria-hidden="true">📡</div>
          <h3>Sunday Live Stream</h3>
          <p>
            Watch our full Sunday morning service live from wherever you are — at home,
            at work, or on the other side of the world.
            Every Sunday at <strong>10:30 am</strong>.
          </p>
          <span class="feature-badge">Coming Soon</span>
        </div>

        <div class="feature-card feature-card--sermons">
          <div class="feature-card__icon" aria-hidden="true">🎬</div>
          <h3>Sermon Archive</h3>
          <p>
            Miss a Sunday? Every talk will be available to watch back in full —
            organised by series, speaker, and theme so you can find exactly what you need.
          </p>
          <span class="feature-badge">Coming Soon</span>
        </div>

        <div class="feature-card feature-card--worship">
          <div class="feature-card__icon" aria-hidden="true">🎵</div>
          <h3>Worship & Music</h3>
          <p>
            Experience Hope's vibrant Sunday worship. We plan to share highlights,
            songs, and moments of praise from our services.
          </p>
          <span class="feature-badge">Planned</span>
        </div>

        <div class="feature-card feature-card--podcast">
          <div class="feature-card__icon" aria-hidden="true">🎧</div>
          <h3>Podcast / Audio</h3>
          <p>
            Prefer to listen on the go? We're exploring making sermons available
            as a podcast — perfect for the commute or a walk.
          </p>
          <span class="feature-badge">Planned</span>
        </div>

      </div>

<!-- STAY UPDATED STRIP -->
      <div class="stay-updated">
        <p class="stay-updated__text">
          Want to know the moment it goes live?
        </p>
<a href="/contact" class="btn btn--gold">Get in Touch</a>
        <a
          href="https://www.youtube.com/@hopecommunitychurch328/featured"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn--outline"
        >
          Subscribe on YouTube ↗
        </a>
      </div>

    </div>
  </section>

  <!-- EMBEDDED PLAYLIST
       Uncomment once YOUTUBE_PLAYLIST_ID is known.
       This shows a scrollable playlist widget.

  <section class="playlist-section">
    <div class="container">
      <h2 class="section-title">Sermon Playlist</h2>
      <div class="video-wrapper">
        <iframe
          src={`https://www.youtube.com/embed/videoseries?list=${YOUTUBE_PLAYLIST_ID}&rel=0`}
          title="Hope Community Church Sermons"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          loading="lazy"
        ></iframe>
      </div>
    </div>
  </section>
  -->

  <!-- PODCAST / AUDIO — future placeholder -->
  <!--
  <section class="podcast-section">
    <div class="container">
      <h2 class="section-title">Listen as a Podcast</h2>
      <p class="section-subtitle">Prefer audio? Find our sermons on Spotify and Apple Podcasts.</p>
      ...podcast links...
    </div>
  </section>
  -->

  <!-- JOIN US CTA -->
  <section class="join-cta">
    <div class="container">
      <div class="join-cta__inner">
        <h2>Better in person</h2>
        <p>
          Watching online is great — but we'd love to meet you face to face.
          Join us this Sunday at 10:30 am.
        </p>
        <div class="join-cta__actions">
          <a href="/whats-on" class="btn btn--gold">What's On</a>
          <a href="/contact" class="btn btn--outline-light">Plan Your Visit</a>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ── PAGE HERO ── */
  .page-hero {
    background: linear-gradient(135deg, #0d1f3c 0%, #1a3a6b 100%);
    padding: 5rem 1.5rem 4rem;
    text-align: center;
  }
  .page-hero__inner { max-width: 640px; margin: 0 auto; }
  .page-hero__eyebrow {
    font-family: 'Nunito', sans-serif;
    font-weight: 800;
    font-size: 0.8rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #c9a84c;
    margin-bottom: 0.75rem;
  }
  .page-hero__title {
    font-family: 'Nunito', sans-serif;
    font-weight: 800;
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    color: #fff;
    margin: 0 0 1rem;
  }
  .page-hero__subtitle {
    font-size: 1.1rem;
    color: #b8cfe8;
    line-height: 1.6;
  }

  /* ── SHARED ── */
  .container { max-width: 1100px; margin: 0 auto; padding: 0 1.5rem; }
  .section-title {
    font-family: 'Nunito', sans-serif;
    font-weight: 800;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    color: #0d1f3c;
    text-align: center;
    margin-bottom: 0.5rem;
  }
  .section-subtitle {
    text-align: center;
    color: #5a7a9a;
    max-width: 560px;
    margin: 0 auto 2.5rem;
    line-height: 1.6;
  }

  /* ── COMING SOON BANNER ── */
  .coming-banner {
    background: #0d1f3c;
    border-bottom: 3px solid #c9a84c;
    padding: 2rem 1.5rem;
  }
  .coming-banner__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    max-width: 1100px;
    margin: 0 auto;
  }
  .coming-banner__icon {
    font-size: 2rem;
    flex-shrink: 0;
  }
  .coming-banner__text h2 {
    font-family: 'Nunito', sans-serif;
    font-weight: 800;
    font-size: 1.2rem;
    color: #c9a84c;
    margin-bottom: 0.2rem;
  }
  .coming-banner__text p { color: #b8cfe8; font-size: 0.95rem; line-height: 1.6; }
  .coming-banner__text strong { color: #fff; }

  /* ── SHOWCASE SECTION ── */
  .showcase-section {
    padding: 5rem 1.5rem;
    background: #f7f9fc;
  }
  .showcase-intro {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 3.5rem;
  }
  .showcase-eyebrow {
    font-family: 'Nunito', sans-serif;
    font-weight: 800;
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #c9a84c;
    margin-bottom: 0.75rem;
  }
  .showcase-title {
    font-family: 'Nunito', sans-serif;
    font-weight: 800;
    font-size: clamp(1.7rem, 3.5vw, 2.4rem);
    color: #0d1f3c;
    margin-bottom: 1rem;
    line-height: 1.2;
  }
  .showcase-subtitle {
    color: #5a7a9a;
    line-height: 1.7;
    font-size: 1.05rem;
  }

  /* FEATURE GRID */
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.5rem;
    margin-bottom: 3.5rem;
  }
  .feature-card {
    background: #fff;
    border-radius: 14px;
    padding: 2rem 1.75rem;
    box-shadow: 0 2px 14px rgba(13,31,60,0.07);
    border-top: 4px solid #4a90c4;
    position: relative;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .feature-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 30px rgba(13,31,60,0.12);
  }
  .feature-card--live    { border-top-color: #e53e3e; }
  .feature-card--sermons { border-top-color: #4a90c4; }
  .feature-card--worship { border-top-color: #c9a84c; }
  .feature-card--podcast { border-top-color: #5a7a9a; }

  .feature-card__icon {
    font-size: 2.2rem;
    margin-bottom: 1rem;
    display: block;
  }
  .feature-card h3 {
    font-family: 'Nunito', sans-serif;
    font-weight: 800;
    font-size: 1.15rem;
    color: #0d1f3c;
    margin-bottom: 0.6rem;
  }
  .feature-card p {
    color: #5a7a9a;
    font-size: 0.92rem;
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }
  .feature-card strong { color: #0d1f3c; }

  .feature-badge {
    display: inline-block;
    font-family: 'Nunito', sans-serif;
    font-weight: 800;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    background: #e8f2f9;
    color: #4a90c4;
    padding: 0.3rem 0.75rem;
    border-radius: 50px;
  }
  .feature-card--live .feature-badge {
    background: #fff5f5;
    color: #e53e3e;
  }
  .feature-card--worship .feature-badge {
    background: #fdf8ec;
    color: #c9a84c;
  }

  /* STAY UPDATED */
  .stay-updated {
    background: linear-gradient(135deg, #0d1f3c 0%, #1a3a6b 100%);
    border-radius: 16px;
    padding: 2.5rem 2rem;
    text-align: center;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }
  .stay-updated__text {
    font-family: 'Nunito', sans-serif;
    font-weight: 800;
    font-size: 1.1rem;
    color: #fff;
    margin: 0;
    flex-basis: 100%;
    margin-bottom: 0.5rem;
  }
  /* ── BUTTONS ── */
  .btn {
    display: inline-block;
    font-family: 'Nunito', sans-serif;
    font-weight: 800;
    font-size: 0.9rem;
    letter-spacing: 0.04em;
    padding: 0.75rem 1.75rem;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.2s ease;
    white-space: nowrap;
  }
  .btn--live {
    background: #e53e3e;
    color: #fff;
  }
  .btn--live:hover { background: #c53030; transform: translateY(-1px); }

  .btn--primary {
    background: #4a90c4;
    color: #fff;
  }
  .btn--primary:hover { background: #357aac; transform: translateY(-1px); }

  .btn--gold {
    background: #c9a84c;
    color: #0d1f3c;
  }
  .btn--gold:hover { background: #d4b55e; transform: translateY(-1px); }

  .btn--outline {
    border: 2px solid #4a90c4;
    color: #4a90c4;
    background: transparent;
  }
  .btn--outline:hover { background: #4a90c4; color: #fff; }

  .btn--outline-light {
    border: 2px solid rgba(255,255,255,0.4);
    color: #fff;
    background: transparent;
  }
  .btn--outline-light:hover { background: rgba(255,255,255,0.1); }

  /* ── SERMONS SECTION ── */
  .sermons-section { padding: 4rem 1.5rem; background: #fff; }

  .sermons-placeholder {
    background: #e8f2f9;
    border-radius: 12px;
    padding: 4rem 2rem;
    text-align: center;
    max-width: 500px;
    margin: 0 auto 2.5rem;
  }
  .sermons-placeholder__icon { font-size: 3rem; margin-bottom: 1rem; }
  .sermons-placeholder h3 {
    font-family: 'Nunito', sans-serif;
    font-weight: 800;
    font-size: 1.4rem;
    color: #0d1f3c;
    margin-bottom: 0.75rem;
  }
  .sermons-placeholder p { color: #5a7a9a; line-height: 1.6; margin-bottom: 1.5rem; }

  /* sermon grid cards */
  .sermon-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }
  .sermon-card {
    background: #f7f9fc;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 2px 10px rgba(13,31,60,0.07);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .sermon-card:hover { transform: translateY(-3px); box-shadow: 0 8px 24px rgba(13,31,60,0.12); }

  .sermon-card__thumb { position: relative; aspect-ratio: 16/9; overflow: hidden; }
  .sermon-card__thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .sermon-card__play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(13,31,60,0.4);
    color: #fff;
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .sermon-card__thumb:hover .sermon-card__play { opacity: 1; }

  .sermon-card__body { padding: 1.25rem 1.5rem; }
  .sermon-card__series {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #4a90c4;
    margin-bottom: 0.4rem;
  }
  .sermon-card__title {
    font-family: 'Nunito', sans-serif;
    font-weight: 800;
    font-size: 1rem;
    color: #0d1f3c;
    margin-bottom: 0.5rem;
  }
  .sermon-card__title a { text-decoration: none; color: inherit; }
  .sermon-card__title a:hover { color: #4a90c4; }
  .sermon-card__meta { font-size: 0.8rem; color: #8aa4bc; }

  .sermons-footer { text-align: center; }

  /* ── VIDEO WRAPPER (for iframe embeds) ── */
  .video-wrapper {
    position: relative;
    padding-bottom: 56.25%; /* 16:9 */
    height: 0;
    overflow: hidden;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(13,31,60,0.15);
  }
  .video-wrapper iframe {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    border: 0;
  }

  /* ── JOIN CTA ── */
  .join-cta {
    background: linear-gradient(135deg, #0d1f3c 0%, #1a3a6b 100%);
    padding: 4rem 1.5rem;
  }
  .join-cta__inner {
    max-width: 600px;
    margin: 0 auto;
    text-align: center;
  }
  .join-cta h2 {
    font-family: 'Nunito', sans-serif;
    font-weight: 800;
    font-size: clamp(1.6rem, 3vw, 2rem);
    color: #fff;
    margin-bottom: 0.75rem;
  }
  .join-cta p { color: #b8cfe8; line-height: 1.6; margin-bottom: 2rem; }
  .join-cta__actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>

---
import Layout from '../layouts/Layout.astro';

const regularServices = [
  {
    title: 'Sunday morning service',
    time: '10:30 am · every Sunday',
    description:
      "Sung worship, Bible teaching, and a warm welcome for all. Children's groups run during the service.",
    colour: '#4a90c4',
  },
  {
    title: 'Sunday evening prayer',
    time: '6:00 pm · every Sunday',
    description:
      'A quieter gathering for prayer and reflection together as a church family.',
    colour: '#c9a84c',
  },
];

// ─────────────────────────────────────────────────────────────────────────────
// PHOTO CAROUSEL IMAGES
// To add a new photo: copy the image into public/images/ and add a new line
// below following the same pattern. The alt text describes what's in the photo
// (this helps people who use screen readers).
// ─────────────────────────────────────────────────────────────────────────────
const carouselImages = [
  { src: '/images/Church-Front.jpg',  alt: 'Hope Community Church building at night' },
  { src: '/images/Church-Back.jpg',   alt: 'Hope Community Church exterior with Cancer Research banner' },
  { src: '/images/Christmas.jpg',     alt: 'Christmas fair inside the church hall' },
  { src: '/images/Food.jpg',          alt: 'Homemade cakes and bakes at a church event' },
  { src: '/images/CoffeeNChat.jpg',   alt: 'Coffee N Chat sign outside the church' },
  { src: '/images/Dadz.jpg',          alt: 'Dadz event poster – first Saturday of each month' },
  { src: '/images/RockyKids.jpg',     alt: 'Rocky Kids – Friday evening youth club poster' },
  { src: '/images/FusionKids.jpg',    alt: 'Fusion Youth event poster' },
  { src: '/images/Snooker.jpg',       alt: 'Young person playing snooker at the church' },
  { src: '/images/Children.jpg',      alt: 'Children playing video games at a church event' },
];
---

<Layout
  title="What's On | Hope Community Church"
  description="Regular services, special events, and everything happening at Hope Community Church in Hinckley."
>

  <!-- PAGE HERO -->
  <section class="bg-navy text-cream py-16 px-6">
    <div class="max-w-4xl mx-auto">
      <h1 class="font-extrabold text-4xl md:text-5xl uppercase tracking-wide mb-3">
        What's on at Hope
      </h1>
      <p class="text-baby-blue text-lg max-w-xl">
        Regular services, special events, and everything in between —
        you're always welcome.
      </p>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════════
    MAIN CONTENT — three columns on desktop, stacked on mobile
    ┌──────────────┬─────────────────────────┬──────────────────┐
    │  Services    │      Calendar           │    Carousel      │
    │  (left col)  │    (centre, wider)      │   (right col)    │
    └──────────────┴─────────────────────────┴──────────────────┘
  ════════════════════════════════════════════════════════════════════════ -->
  <section class="bg-cream py-16 px-6">
    <div class="max-w-screen-2.3xl mx-auto">

      <div class="grid gap-8 grid-cols-1 lg:grid-cols-[1fr_2fr_2fr] items-start">

        <!-- ── COLUMN 1: Regular Services ── -->
        <div>
          <h2 class="font-extrabold text-2xl uppercase text-navy mb-6">
            Regular services
          </h2>

          <div class="flex flex-col gap-5">
            {regularServices.map((s) => (
              <div class="bg-white rounded-2xl p-6 shadow-sm border border-pale-blue">
                <div class="flex items-center gap-3 mb-2">
                  <span
                    class="w-3 h-3 rounded-full shrink-0"
                    style={`background:${s.colour}`}
                  />
                  <h3 class="font-extrabold text-navy text-base uppercase">
                    {s.title}
                  </h3>
                </div>
                <p class="text-sm text-gray-500 mb-3">{s.time}</p>
                <p class="text-navy/80 leading-relaxed text-sm">{s.description}</p>
              </div>
            ))}

            <!-- A small welcome nudge card to fill remaining space -->
            <div class="bg-navy rounded-2xl p-6 text-cream shadow-sm">
              <p class="font-extrabold text-base uppercase mb-2" style="color:#c9a84c">
                New here?
              </p>
              <p class="text-sm leading-relaxed text-cream/80">
                Whether it's your first time or you've been coming for years —
                there's always a seat and a warm welcome waiting for you.
              </p>
            </div>
          </div>
        </div>

        <!-- ── COLUMN 2: Google Calendar (centre, wider) ── -->
        <div>
          <h2 class="font-extrabold text-2xl uppercase text-navy mb-6">
            Full events calendar
          </h2>

          {/* REPLACE the iframe src below once Ian shares the Google Calendar public URL */}
          {/* Instructions: Calendar → Settings → share publicly → copy embed code → paste src here */}
          <div class="rounded-2xl overflow-hidden border border-pale-blue shadow-sm">
            <iframe
              src="https://calendar.google.com/calendar/embed?src=diary%40hopecc.org.uk&ctz=Europe%2FLondon&showTitle=0&showNav=1&showPrint=0&showTabs=0&showCalendars=0&mode=AGENDA"
              style="border:0"
              width="100%"
              height="620"
              frameborder="0"
              scrolling="no"
              title="Hope Community Church events calendar"
            />
          </div>

          <p class="text-sm text-navy font-semibold mt-4 text-center">
            Calendar not showing?{' '}
            <a
              href="https://calendar.google.com/calendar/embed?src=diary%40hopecc.org.uk&ctz=Europe%2FLondon"
              class="text-baby-blue underline"
              target="_blank"
              rel="noopener"
            >
              Open in Google Calendar ↗
            </a>
          </p>
        </div>

        <!-- ── COLUMN 3: Photo Carousel ── -->
        <!--
          HOW THE CAROUSEL WORKS
          ─────────────────────────────────────────────────────────────────
          • All photos are stacked on top of each other (position:absolute).
          • Only the "active" photo is visible; the rest have opacity:0.
          • A small JavaScript timer (at the bottom of this file) switches
            the active photo every 4 seconds with a smooth crossfade.
          • Dot indicators show which photo is active and let visitors click
            to jump to any photo.
          • The container height matches the calendar so both columns align.
          ─────────────────────────────────────────────────────────────────
        -->
        <div>
          <h2 class="font-extrabold text-2xl uppercase text-navy mb-6">
            Life at Hope
          </h2>

          <div
            id="photo-carousel"
            class="relative w-full rounded-2xl overflow-hidden shadow-sm border border-pale-blue bg-navy"
            style="height: 620px;"
            aria-label="Photos from Hope Community Church events"
          >
            {carouselImages.map((img, i) => (
              <img
                src={img.src}
                alt={img.alt}
                class="carousel-slide absolute inset-0 w-full h-full object-cover transition-opacity duration-700"
                style={i === 0 ? 'opacity:1;' : 'opacity:0;'}
                loading={i === 0 ? 'eager' : 'lazy'}
              />
            ))}

            <!-- Dark gradient at bottom so dots stay readable over any photo -->
            <div
              class="absolute bottom-0 left-0 right-0 h-20 pointer-events-none"
              style="background: linear-gradient(to top, rgba(13,31,60,0.7), transparent);"
            />

            <!-- Prev / Next arrows -->
            <button
              id="carousel-prev"
              aria-label="Previous photo"
              class="absolute left-3 top-1/2 -translate-y-1/2 z-10 bg-navy/60 hover:bg-navy/90 text-cream rounded-full w-10 h-10 flex items-center justify-center text-xl transition"
            >
              &#8249;
            </button>
            <button
              id="carousel-next"
              aria-label="Next photo"
              class="absolute right-3 top-1/2 -translate-y-1/2 z-10 bg-navy/60 hover:bg-navy/90 text-cream rounded-full w-10 h-10 flex items-center justify-center text-xl transition"
            >
              &#8250;
            </button>

            <!-- Dot indicators -->
            <div class="absolute bottom-4 left-0 right-0 flex justify-center gap-2 z-10">
              {carouselImages.map((_, i) => (
                <button
                  class="carousel-dot w-2.5 h-2.5 rounded-full transition-all duration-300"
                  style={i === 0
                    ? 'background:#c9a84c; transform:scale(1.3);'
                    : 'background:rgba(255,255,255,0.5);'}
                  aria-label={`Go to photo ${i + 1}`}
                  data-index={i}
                />
              ))}
            </div>
          </div>

          <p class="text-sm text-navy/60 text-center mt-3 italic">
            Photos from our community — follow us on{' '}
            <a
              href="https://www.facebook.com/hopechurchhinc"
              class="text-baby-blue underline"
              target="_blank"
              rel="noopener"
            >
              Facebook
            </a>
          </p>
        </div>

      </div><!-- end grid -->
    </div>
  </section>

  <!-- CTA STRIP -->
  <section class="bg-baby-blue py-10 px-6 text-center">
    <p class="text-white text-lg mb-4">
      Can't find what you're looking for? We'd love to hear from you.
    </p>
    <a
      href="/contact"
      class="inline-block bg-gold text-navy font-extrabold uppercase px-8 py-3 rounded-full tracking-wide hover:opacity-90 transition"
    >
      Contact us
    </a>
  </section>

</Layout>

<!-- ─────────────────────────────────────────────────────────────────────────
  CAROUSEL SCRIPT
  ─────────────────────────────────────────────────────────────────────────
  Handles: auto-advance, prev/next buttons, dot clicks, pause on hover.
  To change speed: find 4000 below and change it (1000 = 1 second).
──────────────────────────────────────────────────────────────────────────── -->
<script>
  (function () {
    const slides = document.querySelectorAll('.carousel-slide');
    const dots   = document.querySelectorAll('.carousel-dot');
    let current  = 0;
    let timer;

    const GOLD  = '#c9a84c';
    const FADED = 'rgba(255,255,255,0.5)';

    function goTo(index) {
      slides[current].style.opacity  = '0';
      dots[current].style.background = FADED;
      dots[current].style.transform  = 'scale(1)';

      current = (index + slides.length) % slides.length;

      slides[current].style.opacity  = '1';
      dots[current].style.background = GOLD;
      dots[current].style.transform  = 'scale(1.3)';
    }

    function next() { goTo(current + 1); }
    function prev() { goTo(current - 1); }

    function startTimer() { timer = setInterval(next, 4000); }
    function resetTimer()  { clearInterval(timer); startTimer(); }

    document.getElementById('carousel-next')?.addEventListener('click', () => { next(); resetTimer(); });
    document.getElementById('carousel-prev')?.addEventListener('click', () => { prev(); resetTimer(); });

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => { goTo(i); resetTimer(); });
    });

    const carousel = document.getElementById('photo-carousel');
    carousel?.addEventListener('mouseenter', () => clearInterval(timer));
    carousel?.addEventListener('mouseleave', startTimer);

    startTimer();
  })();
</script>
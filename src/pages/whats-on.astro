---
// src/pages/whats-on.astro — Hope Community Church
// ─────────────────────────────────────────────────────────────────────────
// WHAT THIS FILE DOES
//   This produces the "What's On" page — regular services, activity cards
//   (Rocky Kids, Fusion Youth, etc.), the events calendar, and a photo
//   gallery.
//
// HOW TO MAKE COMMON CHANGES
//   • Service times & descriptions → edit the regularServices list below
//     (search "EDIT: service times")
//   • Activity cards (day, time,
//     price, description, photo)   → edit the activities list below
//     (search "EDIT: activity cards")
//   • Gallery photos                → edit the galleryImages list below
//     (search "EDIT: gallery images") — add or remove photos freely, the
//     grid automatically arranges portrait, landscape and square photos
//   • Calendar                      → the embedded calendar uses
//     diary@hopecc.org.uk — no changes needed unless that email address
//     changes (search "EDIT: calendar")
//   • Page hero text                → search "EDIT: hero text"
//   • Bottom call-to-action text    → search "EDIT: cta text"
//
// This file has two parts, in this order:
//   1. The lists below (regularServices, activities, galleryImages) plus
//      the HTML further down — the words and layout people see on the
//      page, broken into labelled sections (HERO, SERVICES, etc.)
//   2. The <style> block near the end — colours, spacing and fonts.
//      You shouldn't need to touch the <style> block for normal updates.
// ─────────────────────────────────────────────────────────────────────────
import Layout from '../layouts/Layout.astro';

// EDIT: service times — each entry below is one row on the "Services" section

const regularServices = [
  {
    title: 'Sunday Morning Service',
    time: '10:30 am · Every Sunday',
    description: "Sung worship, Bible teaching, and a warm welcome for all. Children's groups run during the service.",
    icon: '☀️',
    colour: '#4a90c4',
  },
  {
    title: 'Sunday Evening Prayer',
    time: '6:00 pm · Every Sunday',
    description: 'A quieter gathering for prayer and reflection together as a church family.',
    icon: '🌙',
    colour: '#c9a84c',
  },
  {
    title: 'Coffee N Chat',
    time: '10:00 am · Every Tuesday',
    description: 'Drop in for a coffee, a chat, and great company. Everyone is welcome — no strings attached.',
    icon: '☕',
    colour: '#5ba08a',
  },
];

// ── EDIT: activity cards ─────────────────────────────────────────────────
// Each activity card shows an image (a poster or photo), a title, key
// details, and a short description. Update the text directly below; the
// image files themselves live in the public/images/ folder — change the
// `img` value to point at a different file to swap the photo.
// ─────────────────────────────────────────────────────────────────────────
const activities = [
  {
    title: 'Rocky Kids',
    img: '/images/RockyKids.jpg',
    tag: 'Children · Yrs 2–6',
    schedule: 'Fridays in term time · 5:30–7:15pm',
    price: '£2 entry',
    description: 'Games, crafts, team challenges, worship, and a tuck shop. A fantastic Friday night out for primary school children.',
    colour: '#9b2020',
    tagColour: '#9b2020',
  },
  {
    title: 'Fusion Youth',
    img: '/images/FusionKids.jpg',
    tag: 'Youth · Yr 7+',
    schedule: 'First 3 Fridays monthly · 7:45–9:30pm',
    price: '£1.50 entry',
    description: 'Tribal wars, team games, table games, hot chocolates, and a tuck shop. An amazing night out for secondary-age young people.',
    colour: '#1a3a1a',
    tagColour: '#2d6e2d',
  },
  {
    title: 'Dadz',
    img: '/images/Dadz.jpg',
    tag: 'Families',
    schedule: 'First Saturday monthly · 10am–12noon',
    price: '£5 per family',
    description: 'Dads and kids — arts & crafts, video games, pool, snooker, table tennis, and a hot breakfast cob. A brilliant morning together.',
    colour: '#1a3556',
    tagColour: '#2c5f9e',
  },
  {
    title: 'Coffee N Chat',
    img: '/images/CoffeeNChat.jpg',
    tag: 'Everyone Welcome',
    schedule: 'Every Tuesday · 10:00am',
    price: 'Free',
    description: 'A relaxed morning drop-in for anyone in the community. Come for coffee, stay for the conversation.',
    colour: '#5b3a1a',
    tagColour: '#c07d3a',
  },
];

// ── EDIT: gallery images ────────────────────────────────────────────────
// These appear in a masonry grid — portrait, landscape, square photos are
// all handled automatically. Add or remove images freely by adding or
// removing lines below; each photo also needs a short alt description
// (what's in the photo) for accessibility.
// ─────────────────────────────────────────────────────────────────────────
const galleryImages = [
  { src: '/images/Church-Front.jpg',  alt: 'Hope Community Church lit up at night' },
  { src: '/images/Christmas.jpg',     alt: 'Christmas fair inside the church hall' },
  { src: '/images/Food.jpg',          alt: 'Homemade cakes and bakes at a church event' },
  { src: '/images/Children.jpg',      alt: 'Children playing video games at a church event' },
  { src: '/images/Snooker.jpg',       alt: 'Young person playing snooker at the church' },
  { src: '/images/Church-Back.jpg',   alt: 'Hope Community Church front entrance' },
];
---

<!-- EDIT: page title/description — shown in browser tabs and search engine results -->
<Layout
  title="What's On | Hope Community Church"
  description="Regular services, special events, and everything happening at Hope Community Church in Hinckley. Sunday services, Rocky Kids, Fusion Youth, Dadz, Coffee N Chat and more."
>

<!-- ════════════════════════════════════════════════
     HERO
     EDIT: hero text — the heading and subtitle below
════════════════════════════════════════════════ -->
<section class="wo-hero">
  <div class="wo-hero-bg" aria-hidden="true">
    <img src="/images/Church-Front.jpg" alt="" class="wo-hero-img" />
    <div class="wo-hero-overlay"></div>
  </div>
  <div class="wo-hero-content">
    <span class="wo-eyebrow">Hope Community Church · Hinckley</span>
    <h1 class="wo-hero-title">What's On<br><em>at Hope</em></h1>
    <p class="wo-hero-sub">
      Regular services, special events, and everything in between —
      you're always welcome.
    </p>
    <div class="wo-hero-ctas">
      <a href="#services" class="wo-btn-gold">Our Services</a>
      <a href="#calendar" class="wo-btn-outline">Full Calendar</a>
    </div>
  </div>
  <div class="wo-hero-wave" aria-hidden="true">
    <svg viewBox="0 0 1440 80" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
      <path d="M0,40 C360,80 1080,0 1440,40 L1440,80 L0,80 Z" fill="#f7f9fc"/>
    </svg>
  </div>
</section>

<!-- ════════════════════════════════════════════════
     SERVICES
     EDIT: service times — the section heading/intro below, and the
     regularServices list near the top of this file for the cards
════════════════════════════════════════════════ -->
<section class="wo-section wo-services-section" id="services">
  <div class="wo-container">
    <div class="wo-section-header">
      <span class="wo-label">Every week</span>
      <h2 class="wo-section-title">Regular Services</h2>
      <p class="wo-section-sub">Whether it's your first visit or you've been coming for years — there's always a seat and a warm welcome waiting for you.</p>
    </div>

    <div class="wo-services-grid">
      {regularServices.map((s) => (
        <div class="wo-service-card">
          <div class="wo-service-bar" style={`background:${s.colour}`}></div>
          <div class="wo-service-icon" style={`background:${s.colour}18; color:${s.colour}`}>
            <span>{s.icon}</span>
          </div>
          <div class="wo-service-body">
            <h3 class="wo-service-title">{s.title}</h3>
            <p class="wo-service-time">{s.time}</p>
            <p class="wo-service-desc">{s.description}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- EDIT: "New here?" callout — the text below -->
    <div class="wo-new-here">
      <div class="wo-new-here-icon">👋</div>
      <div>
        <strong>New here?</strong>
        Our Sunday morning service at 10:30am is a great place to start.
        Come as you are — no dress code, no pressure.
        <a href="/contact" class="wo-inline-link">Get in touch if you have questions →</a>
      </div>
    </div>
  </div>
</section>

<!-- Wave into dark section -->
<div class="wo-wave-divider wo-wave-top" aria-hidden="true">
  <svg viewBox="0 0 1440 60" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
    <path d="M0,0 C480,60 960,0 1440,30 L1440,60 L0,60 Z" fill="#0d1f3c"/>
  </svg>
</div>

<!-- ════════════════════════════════════════════════
     ACTIVITIES
     EDIT: activity cards — the section heading/intro below, and the
     activities list near the top of this file for the cards themselves
════════════════════════════════════════════════ -->
<section class="wo-section wo-activities-section" id="activities">
  <div class="wo-container">
    <div class="wo-section-header wo-section-header--light">
      <span class="wo-label wo-label--gold">What's happening</span>
      <h2 class="wo-section-title wo-section-title--light">Activities &amp; Groups</h2>
      <p class="wo-section-sub wo-section-sub--light">Something for every age and stage — all based right here at Hope.</p>
    </div>

    <div class="wo-activities-grid">
      {activities.map((a) => (
        <div class="wo-activity-card">
          <div class="wo-activity-img-wrap">
            <img src={a.img} alt={a.title} class="wo-activity-img" loading="lazy" />
            <span class="wo-activity-tag" style={`background:${a.tagColour}`}>{a.tag}</span>
          </div>
          <div class="wo-activity-body">
            <h3 class="wo-activity-title">{a.title}</h3>
            <div class="wo-activity-meta">
              <span class="wo-meta-item">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                {a.schedule}
              </span>
              <span class="wo-meta-item wo-meta-price">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20.59 13.41 13.42 20.58a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82Z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
                {a.price}
              </span>
            </div>
            <p class="wo-activity-desc">{a.description}</p>
          </div>
          <div class="wo-activity-accent" style={`background:${a.colour}`}></div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- Wave out of dark section -->
<div class="wo-wave-divider wo-wave-bottom" aria-hidden="true">
  <svg viewBox="0 0 1440 60" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
    <path d="M0,30 C480,60 960,0 1440,30 L1440,0 L0,0 Z" fill="#0d1f3c"/>
  </svg>
</div>

<!-- ════════════════════════════════════════════════
     CALENDAR
     EDIT: calendar — the heading/intro text below. The calendar itself
     pulls live from Google Calendar (diary@hopecc.org.uk) so events don't
     need to be added here — just add them to that Google Calendar directly.
════════════════════════════════════════════════ -->
<section class="wo-section wo-calendar-section" id="calendar">
  <div class="wo-container">
    <div class="wo-calendar-layout">
      <div class="wo-calendar-intro">
        <span class="wo-label">Always up to date</span>
        <h2 class="wo-section-title">Full Events Calendar</h2>
        <p class="wo-section-sub">Our live calendar shows everything happening at Hope — services, activities, room bookings, and more. Updated in real time.</p>
        <div class="wo-calendar-tips">
          <div class="wo-tip">
            <span class="wo-tip-icon">📅</span>
            <span>Click any event for full details</span>
          </div>
          <div class="wo-tip">
            <span class="wo-tip-icon">🔔</span>
            <span>Add to your own Google Calendar</span>
          </div>
          <div class="wo-tip">
            <span class="wo-tip-icon">📱</span>
            <span>Works on phone and tablet too</span>
          </div>
        </div>
        <a
          href="https://calendar.google.com/calendar/embed?src=diary%40hopecc.org.uk&ctz=Europe%2FLondon"
          class="wo-btn-navy"
          target="_blank"
          rel="noopener"
        >
          Open in Google Calendar ↗
        </a>
      </div>

      <div class="wo-calendar-embed-wrap">
        <div class="wo-calendar-chrome">
          <div class="wo-calendar-chrome-bar">
            <span class="wo-chrome-dot wo-chrome-dot--r"></span>
            <span class="wo-chrome-dot wo-chrome-dot--y"></span>
            <span class="wo-chrome-dot wo-chrome-dot--g"></span>
            <span class="wo-chrome-label">Hope Community Church Calendar</span>
          </div>
          <div class="wo-calendar-frame-wrap">
            <!-- EDIT: calendar — if the calendar email address ever changes, update the src value below (it appears twice on this page — also update the "Open in Google Calendar" link above) -->
            <iframe
              src="https://calendar.google.com/calendar/embed?src=diary%40hopecc.org.uk&ctz=Europe%2FLondon&showTitle=0&showNav=1&showPrint=0&showTabs=0&showCalendars=0&mode=AGENDA"
              style="border:0"
              width="100%"
              height="540"
              frameborder="0"
              scrolling="no"
              title="Hope Community Church events calendar"
            ></iframe>
          </div>
        </div>
        <p class="wo-calendar-fallback">
          Calendar not showing?
          <a href="https://calendar.google.com/calendar/embed?src=diary%40hopecc.org.uk&ctz=Europe%2FLondon" target="_blank" rel="noopener" class="wo-inline-link">Open in Google Calendar ↗</a>
        </p>
      </div>
    </div>
  </div>
</section>

<!-- ════════════════════════════════════════════════
     GALLERY — masonry grid, handles all image sizes
     EDIT: gallery images — the section heading/intro below, and the
     galleryImages list near the top of this file for the photos themselves
════════════════════════════════════════════════ -->
<section class="wo-section wo-gallery-section" id="gallery">
  <div class="wo-container">
    <div class="wo-section-header">
      <span class="wo-label">Our community</span>
      <h2 class="wo-section-title">Life at Hope</h2>
      <p class="wo-section-sub">
        A snapshot of what it looks like to be part of Hope Community Church.
        <a href="https://www.facebook.com/hopechurchhinc" class="wo-inline-link" target="_blank" rel="noopener">Follow us on Facebook for more →</a>
      </p>
    </div>

    <!--
      HOW THE MASONRY GALLERY WORKS
      ────────────────────────────────────────
      Photos are placed into CSS columns. They automatically stack and fill
      the space — portrait photos, landscape photos, posters — all work.
      Add as many photos as you like to the galleryImages list near the top
      of this file and they will just flow in naturally. No resizing needed.
    -->
    <div class="wo-masonry">
      {galleryImages.map((img) => (
        <div class="wo-masonry-item">
          <img
            src={img.src}
            alt={img.alt}
            class="wo-masonry-img"
            loading="lazy"
          />
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ════════════════════════════════════════════════
     CTA STRIP
     EDIT: cta text — the heading, text and buttons below
════════════════════════════════════════════════ -->
<section class="wo-cta-section">
  <div class="wo-cta-inner">
    <div class="wo-cta-text">
      <h2>Can't find what you're looking for?</h2>
      <p>We'd love to hear from you — drop us a message, give us a call, or just show up on a Sunday.</p>
    </div>
    <div class="wo-cta-buttons">
      <a href="/contact" class="wo-btn-gold">Get in Touch</a>
      <a href="/room-hire" class="wo-btn-outline">Room Hire</a>
    </div>
  </div>
</section>

</Layout>

<!-- ════════════════════════════════════════════════
     STYLES
════════════════════════════════════════════════ -->
<style>
  /* ── Design tokens ─────────────────────────────────────────────────────── */
  :root {
    --navy:      #0d1f3c;
    --blue:      #4a90c4;
    --pale-blue: #e8f2f9;
    --gold:      #c9a84c;
    --gold-dark: #b8943d;
    --cream:     #f7f9fc;
    --text:      #1a2a3a;
    --muted:     #4a5568;
    --font:      'Nunito', 'Century Gothic', sans-serif;
    --radius:    14px;
    --shadow:    0 4px 24px rgba(13,31,60,0.10);
    --shadow-lg: 0 8px 40px rgba(13,31,60,0.16);
  }

  * { box-sizing: border-box; }

  .wo-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .wo-section { padding: 80px 0; }

  .wo-section-header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 56px;
  }

  .wo-label {
    display: inline-block;
    font-family: var(--font);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--blue);
    margin-bottom: 10px;
  }

  .wo-label--gold { color: var(--gold); }

  .wo-section-title {
    font-family: var(--font);
    font-size: clamp(26px, 4vw, 38px);
    font-weight: 800;
    color: var(--navy);
    margin: 0 0 14px;
    line-height: 1.2;
  }

  .wo-section-title--light { color: #ffffff; }

  .wo-section-sub {
    font-family: var(--font);
    font-size: 16px;
    line-height: 1.7;
    color: var(--muted);
    margin: 0;
  }

  .wo-section-sub--light { color: rgba(255,255,255,0.72); }
  .wo-section-header--light .wo-section-title { color: #fff; }

  .wo-inline-link {
    color: var(--blue);
    text-decoration: underline;
    font-weight: 700;
  }

  /* ── Buttons ───────────────────────────────────────────────────────────── */
  .wo-btn-gold {
    display: inline-block;
    font-family: var(--font);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--navy);
    background: var(--gold);
    padding: 14px 30px;
    border-radius: 50px;
    transition: background 0.18s, transform 0.15s;
    white-space: nowrap;
  }
  .wo-btn-gold:hover { background: var(--gold-dark); color: #fff; transform: translateY(-2px); }

  .wo-btn-outline {
    display: inline-block;
    font-family: var(--font);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    text-decoration: none;
    color: #ffffff;
    background: transparent;
    border: 2px solid rgba(255,255,255,0.45);
    padding: 14px 30px;
    border-radius: 50px;
    transition: border-color 0.18s, background 0.18s;
    white-space: nowrap;
  }
  .wo-btn-outline:hover { border-color: #fff; background: rgba(255,255,255,0.1); }

  .wo-btn-navy {
    display: inline-block;
    font-family: var(--font);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    text-decoration: none;
    color: #fff;
    background: var(--navy);
    padding: 13px 28px;
    border-radius: 50px;
    transition: background 0.18s;
    white-space: nowrap;
  }
  .wo-btn-navy:hover { background: var(--blue); }

  /* ── HERO ──────────────────────────────────────────────────────────────── */
  .wo-hero {
    position: relative;
    min-height: 560px;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .wo-hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .wo-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
  }

  .wo-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(13,31,60,0.92) 0%,
      rgba(13,31,60,0.75) 50%,
      rgba(13,31,60,0.55) 100%
    );
  }

  .wo-hero-content {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
    padding: 80px 24px 100px;
    width: 100%;
  }

  .wo-eyebrow {
    display: inline-block;
    font-family: var(--font);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 16px;
  }

  .wo-hero-title {
    font-family: var(--font);
    font-size: clamp(42px, 7vw, 80px);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.05;
    margin: 0 0 20px;
    letter-spacing: -0.02em;
  }

  .wo-hero-title em {
    font-style: normal;
    color: var(--gold);
  }

  .wo-hero-sub {
    font-family: var(--font);
    font-size: 18px;
    line-height: 1.65;
    color: rgba(255,255,255,0.82);
    max-width: 520px;
    margin: 0 0 36px;
  }

  .wo-hero-ctas {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  .wo-hero-wave {
    position: absolute;
    bottom: -2px;
    left: 0;
    right: 0;
    z-index: 2;
    line-height: 0;
  }

  .wo-hero-wave svg { display: block; width: 100%; }

  /* ── SERVICES ──────────────────────────────────────────────────────────── */
  .wo-services-section { background: var(--cream); }

  .wo-services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
    margin-bottom: 32px;
  }

  .wo-service-card {
    background: #ffffff;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s, box-shadow 0.2s;
    border: 1px solid rgba(13,31,60,0.07);
  }

  .wo-service-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .wo-service-bar {
    height: 5px;
    width: 100%;
    flex-shrink: 0;
  }

  .wo-service-icon {
    width: 52px;
    height: 52px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    margin: 24px 24px 0;
    flex-shrink: 0;
  }

  .wo-service-body {
    padding: 16px 24px 28px;
    flex: 1;
  }

  .wo-service-title {
    font-family: var(--font);
    font-size: 17px;
    font-weight: 800;
    color: var(--navy);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    margin: 0 0 6px;
  }

  .wo-service-time {
    font-family: var(--font);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--muted);
    text-transform: uppercase;
    margin: 0 0 12px;
  }

  .wo-service-desc {
    font-family: var(--font);
    font-size: 14px;
    line-height: 1.65;
    color: var(--text);
    margin: 0;
  }

  .wo-new-here {
    display: flex;
    align-items: center;
    gap: 20px;
    background: var(--navy);
    border-radius: var(--radius);
    padding: 24px 28px;
